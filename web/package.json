{
  "name": "litespm-market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/emit-catalog-shards.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/emit-catalog-shards.mjs && node scripts/gen_brand_logos.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/check-hook-order.mjs && node scripts/check-orphan-components.mjs && node scripts/check-search-settled.mjs && node scripts/check-search-index.mjs && node scripts/check-install-command.mjs && node scripts/check-contrast.mjs && node scripts/check-publisher-counts.mjs && node scripts/check-og-image.mjs",
    "lint:links": "python3 ../scripts/check_site_links.py out --dataset data/catalog.json --featured data/featured.json",
    "check:search-index": "node scripts/check-search-index.mjs",
    "gen:brands": "node scripts/gen_brand_logos.mjs",
    "gen:og": "node scripts/gen_og_image.mjs",
    "type-check": "tsc --noEmit",
    "test:browser": "playwright test",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "check:sort-order": "node scripts/check-sort-order.mjs",
    "profile:projection": "node scripts/profile-projection.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "next": "15.5.28",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "miniflare": "5.20261012.1-beta",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
