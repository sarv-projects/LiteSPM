{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "litespm-web",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-05-05",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		"NEXT_PUBLIC_SITE_ORIGIN": "https://litespm-web.sarveshbh-2022.workers.dev"
	},
	"d1_databases": [
		{
			"binding": "litespm_db",
			"database_name": "litespm-db",
			"database_id": "1cc9862f-8597-4e21-8547-457a762a568d"
		}
	]
}
