# LiteSPM Web & API Configuration

# Database Configuration
# Local SQLite:
DATABASE_URL="file:../db/custom.db"
# Or Remote Turso / libSQL (e.g. for Vercel deployment):
# DATABASE_URL="libsql://litespm-sarveshbh.aws-ap-south-1.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# LLM Gateway Configuration
# Set order of providers to use (e.g. "groq" to use Groq exclusively):
LLM_PROVIDER_ORDER="groq"

# Groq Configuration (https://console.groq.com/)
# Exact Groq Models: openai/gpt-oss-120b (Primary) and qwen/qwen3.8-27b (Fallback)
GROQ_MODELS="openai/gpt-oss-120b,qwen/qwen3.8-27b"
GROQ_API_KEY_1=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""

# Optional Additional Providers:
# The Z.AI Web Dev SDK is disabled by default. Enable only when a valid
# .z-ai-config file is provisioned in the server's working directory, home,
# or /etc; it is not a keyless Vercel provider.
# LLM_ZAI_ENABLED="1"

# 1. Google Gemini:
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"

# 2. NVIDIA NIM:
# NVIDIA_API_KEY=""
# NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# 3. OpenRouter:
# OPENROUTER_API_KEY=""

# Optional hybrid documentation RAG embeddings (OpenAI-compatible API):
# Set the same values in build and runtime environments so document chunks
# and user queries are embedded in the same vector space.
# EMBEDDING_API_KEY=""
# EMBEDDING_BASE_URL="https://api.openai.com/v1"
# EMBEDDING_MODEL="text-embedding-3-small"
