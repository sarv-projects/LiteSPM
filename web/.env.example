# LiteSPM Web & API Configuration

# SQLite Database URL
# Prisma schema is located in prisma/schema.prisma
# Relative SQLite URLs resolve relative to the prisma schema folder:
DATABASE_URL="file:../db/custom.db"

# LLM Gateway Configuration
# Provider execution order (comma-separated list of enabled providers):
# Options: gemini, groq, nvidia, openrouter, zai, or custom generic provider names
LLM_PROVIDER_ORDER="gemini,groq,nvidia,openrouter"

# 1. Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=""
# Additional keys for round-robin rotation & rate-limit resilience:
# GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2=""
# Optional model override (default: gemini-2.0-flash):
# GEMINI_MODEL="gemini-2.0-flash"

# 2. Groq (https://console.groq.com/)
GROQ_API_KEY=""
# GROQ_API_KEY_1=""
# GROQ_API_KEY_2=""
# Optional model override (default: llama-3.3-70b-versatile):
# GROQ_MODEL="llama-3.3-70b-versatile"

# 3. NVIDIA NIM (https://build.nvidia.com/)
NVIDIA_API_KEY=""
# NVIDIA_API_KEY_1=""
# NVIDIA_API_KEY_2=""
# Optional model override (default: meta/llama-3.3-70b-instruct):
# NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# 4. OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=""
# OPENROUTER_API_KEY_1=""
# OPENROUTER_API_KEY_2=""
# Optional model override:
# OPENROUTER_MODEL=""

# 5. Generic OpenAI-Compatible Providers (e.g. Together AI, DeepSeek, Local Ollama/vLLM)
# Via JSON:
# LLM_GENERIC_JSON='[{"name":"deepseek","baseUrl":"https://api.deepseek.com/v1","apiKey":"...","model":"deepseek-chat","style":"openai","priority":10}]'
# Or via numbered variables:
# LLM_GENERIC_1_NAME="deepseek"
# LLM_GENERIC_1_BASE_URL="https://api.deepseek.com/v1"
# LLM_GENERIC_1_API_KEY=""
# LLM_GENERIC_1_MODEL="deepseek-chat"
# LLM_GENERIC_1_STYLE="openai"
# LLM_GENERIC_1_PRIORITY=10
