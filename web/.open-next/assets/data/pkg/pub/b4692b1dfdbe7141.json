,"provenance":"awesome-list-claim","url":"https://github.com/brave/brave-search-skills/tree/main/skills/news-search"},"stars":null,"version":null,"skillSource":"https://github.com/brave/brave-search-skills/tree/main/skills/news-search","installability":"metadata_verified","source":"feed:voltagent-awesome-agent-skills","linkKey":"skill:brave:news-search"},{"id":"skill:brave:spellcheck","name":"Spellcheck","slug":"spellcheck","kind":"skill","summary":"USE FOR spell correction. Returns corrected query if misspelled. Most search endpoints have spellcheck built-in; use this only for pre-search query cleanup or \"Did you mean?\" UI.","category":"TypeScript Skills","publisher":{"name":"brave","verified":false,"provenance":"awesome-list-claim","url":"https://github.com/brave/brave-search-skills/tree/main/skills/spellcheck"},"stars":null,"version":null,"skillSource":"https://github.com/brave/brave-search-skills/tree/main/skills/spellcheck","installability":"metadata_verified","source":"feed:voltagent-awesome-agent-skills","linkKey":"spellcheck"},{"id":"skill:brave:suggest","name":"Suggest","slug":"suggest","kind":"skill","summary":"USE FOR query autocomplete/suggestions. Fast (<100ms). Returns suggested queries as user types. Supports rich suggestions with entity info. Typo-resilient.","category":"TypeScript Skills","publisher":{"name":"brave","verified":false,"provenance":"awesome-list-claim","url":"https://github.com/brave/brave-search-skills/tree/main/skills/suggest"},"stars":null,"version":null,"skillSource":"https://github.com/brave/brave-search-skills/tree/main/skills/suggest","installability":"metadata_verified","source":"feed:voltagent-awesome-agent-skills","linkKey":"suggest"},{"id":"skill:brave:videos-search","name":"Videos Search","slug":"videos-search","kind":"skill","summary":"USE FOR video search. Returns videos with title, URL, thumbnail, duration, view count, creator. Supports freshness filters, SafeSearch, pagination.","category":"TypeScript Skills","publish