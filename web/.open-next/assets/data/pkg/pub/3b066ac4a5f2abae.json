.skills.sh/nomadamas/k-skill/flight-ticket-search"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/flight-ticket-search","installability":"discovery_only","source":"feed:skills-sh","linkKey":"flight-ticket-search"},{"id":"skill:nomadamas:foresttrip-vacancy","name":"Foresttrip Vacancy","slug":"foresttrip-vacancy","kind":"skill","summary":"Look up available Korean national forest recreation lodging or camping slots on foresttrip.go.kr and, in Dolshoi, continue into the official booking flow with approval-gated payment.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/foresttrip-vacancy"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/foresttrip-vacancy","installability":"discovery_only","source":"feed:skills-sh","linkKey":"foresttrip-vacancy"},{"id":"skill:nomadamas:fsc-corporate-info","name":"Fsc Corporate Info","slug":"fsc-corporate-info","kind":"skill","summary":"금융위원회 기업기본정보(법인 개요)를 공공데이터포털 API(k-skill-proxy 경유)로 조회한다. 법인명으로 대표자·설립일·업종 등 법인 개요를 확인하고, 응답에 사업자번호가 있으면 입력 번호와 교차검증한다.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/fsc-corporate-info"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/fsc-corporate-info","installability":"discovery_only","source":"feed:skills-sh","linkKey":"fsc-corporate-info"},{"id":"skill:nomadamas:g2b-order-plan-search","name":"G2B Order Plan Search","slug":"g2b-order-plan-search","kind":"skill","summary":"조달청 나라장터 발주계획현황서비스로 물품·공사·용역·외자 발주계획 목록을 검색한다. 돌쇠에서는 가능한 가장 가까운 합법적 공식 단계까지 준비한다.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/g2b-order-plan-search"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/g2b-order-plan-search","installability":"discovery_only","source":"feed:skills-sh","linkKey":"g2b-order-plan-search"},{"id":"skill:nomadamas:g2b-sanctioned-supplier","name":"G2B Sanctioned Supplier","slug":"g2b-sanctioned-supplier","kind":"skill","summary":"조달청 나라장터 부정당제재업체정보를 공공데이터포털 API(k-skill-proxy 경유)로 조회한다. 사업자등록번호 정확 일치로 조회시점 현재 유효한 입찰참가자격 제한(부정당제재)의 기간·제재기관·근거법률을 확인한다.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/g2b-sanctioned-supplier"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/g2b-sanctioned-supplier","installability":"discovery_only","source":"feed:skills-sh","linkKey":"g2b-sanctioned-supplier"},{"id":"skill:nomadamas:gangnamunni-clinic-search","name":"Gangnamunni Clinic Search","slug":"gangnamunni-clinic-search","kind":"skill","summary":"강남언니 공개 검색 페이지에서 성형외과·피부과 병원 후보, 평점, 리뷰 수, 지원 언어, 공개 병원 링크를 조회한다. 돌쇠에서는 공식 표면을 통한 후속 액션까지 진행한다.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/gangnamunni-clinic-search"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/gangnamunni-clinic-search","installability":"discovery_only","source":"feed:skills-sh","linkKey":"gangnamunni-clinic-search"},{"id":"skill:nomadamas:geeknews-search","name":"Geeknews Search","slug":"geeknews-search","kind":"skill","summary":"GeekNews public RSS/Atom feed로 긱뉴스 게시물을 조회, 검색, 상세 확인하는 읽기 전용 스킬.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/geeknews-search"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/geeknews-search","installability":"discovery_only","source":"feed:skills-sh","linkKey":"geeknews-search"},{"id":"skill:nomadamas:gongsijiga-search","name":"Gongsijiga Search","slug":"gongsijiga-search","kind":"skill","summary":"대한민국 국토교통부가 매년 공시하는 \"개별공시지가\"(원/㎡) 조회. 지번 단위 토지의 정부 공시 단가로, 재산세·종부세·양도세 등 세금 산정의 법적 기준이다. **시세/실거래가가 아니다.** Use when the user asks for 공시지가, 개별공시지가, 토지 공시단가, 세무 계산용 토지 단가, or \"이 땅 공시지가 얼마야\". Do NOT use for 시세, 실거래가, 매매가, 호가, 공동주택가격 (those need a different data source).","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/gongsijiga-search"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/gongsijiga-search","installability":"discovery_only","source":"feed:skills-sh","linkKey":"gongsijiga-search"},{"id":"skill:nomadamas:gov-overseas-trip-report","name":"Gov Overseas Trip Report","slug":"gov-overseas-trip-report","kind":"skill","summary":"선관위·권익위·정보공개포털·주요 지방의회 등 검증된 공개 표면에서 공무국외출장/국외훈련 보고서·현황을 조회하고, 첨부 원문이 있으면 kordoc으로 사실·공개성·검토 신호만 구조화한다. 부정부패 판정 도구가 아니다.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/gov-overseas-trip-report"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/gov-overseas-trip-report","installability":"discovery_only","source":"feed:skills-sh","linkKey":"gov-overseas-trip-report"},{"id":"skill:nomadamas:government-support-survey","name":"Government Support Survey","slug":"government-support-survey","kind":"skill","summary":"K-Startup·기업마당·NIPA·KOCCA·SMTECH의 공개 정부지원 공고를 k-skill-proxy로 전수조사하고 프로젝트 적합성을 보수적으로 분류한다. 사용자가 정부지원사업, 창업지원, 사업화·R&D·바우처·입주공간 공고를 한 번에 찾아달라고 할 때 사용한다.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/government-support-survey"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/government-support-survey","installability":"discovery_only","source":"feed:skills-sh","linkKey":"government-support-survey"},{"id":"skill:nomadamas:han-river-water-level","name":"Han River Water Level","slug":"han-river-water-level","kind":"skill","summary":"한강홍수통제소 기반 현재 수위/유량을 관측소명 또는 관측소코드로 조회한다. 기본 경로는 k-skill-proxy의 han-river water-level endpoint다.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/han-river-water-level"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/han-river-water-level","installability":"discovery_only","source":"feed:skills-sh","linkKey":"han-river-water-level"},{"id":"skill:nomadamas:hankookilbo-news","name":"Hankookilbo News","slug":"hankookilbo-news","kind":"skill","summary":"한국일보 공식 원격 MCP 서버(mcp.hankookilbo.com)를 인증 없이 직접 호출해 편집 헤드라인·많이 본·꼼꼼히 본·최신 기사·섹션별 편집 추천·주제 검색·오늘의 운세를 기사 메타데이터(제목·발행시각·원문 링크) 중심으로 조회한다.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/hankookilbo-news"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/hankookilbo-news","installability":"discovery_only","source":"feed:skills-sh","linkKey":"hankookilbo-news"},{"id":"skill:nomadamas:highway-traffic-status","name":"Highway Traffic Status","slug":"highway-traffic-status","kind":"skill","summary":"한국도로공사·국가교통정보센터 공개 API로 고속도로 실시간 소통(구간별 속도/교통량/정체 등급)과 CCTV 스트림 메타데이터를 조회한다. Use when the user asks 고속도로 정체, 교통 상황, 노선/구간 소통, 고속도로 CCTV. Not for 대중교통 길찾기 or 자동차 경로 안내.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/highway-traffic-status"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/highway-traffic-status","installability":"discovery_only","source":"feed:skills-sh","linkKey":"highway-traffic-status"},{"id":"skill:nomadamas:hipass-receipt","name":"Hipass Receipt","slug":"hipass-receipt","kind":"skill","summary":"공식 하이패스 홈페이지에서 사용자가 직접 로그인한 Chrome 세션을 재사용해 사용내역 조회와 영수증 팝업 진입을 돕는다. 돌쇠에서는 공식 표면을 통한 후속 액션까지 진행한다.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/hipass-receipt"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/hipass-receipt","installability":"discovery_only","source":"feed:skills-sh","linkKey":"hipass-receipt"},{"id":"skill:nomadamas:hola-poke-yeoksam","name":"Hola Poke Yeoksam","slug":"hola-poke-yeoksam","kind":"skill","summary":"올라포케 역삼점의 메뉴·매장 정보·이벤트 참여 흐름을 remote MCP 서버 기준으로 안내한다. 돌쇠에서는 공식 표면을 통한 후속 액션까지 진행한다.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/hola-poke-yeoksam"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/hola-poke-yeoksam","installability":"discovery_only","source":"feed:skills-sh","linkKey":"hola-poke-yeoksam"},{"id":"skill:nomadamas:household-waste-info","name":"Household Waste Info","slug":"household-waste-info","kind":"skill","summary":"Use when the user asks for 생활쓰레기 배출 요일/시간/장소 정보 by 지역명(시군구) and wants official data.go.kr household waste guidance.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/household-waste-info"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/household-waste-info","installability":"discovery_only","source":"feed:skills-sh","linkKey":"household-waste-info"},{"id":"skill:nomadamas:housing-official-price","name":"Housing Official Price","slug":"housing-official-price","kind":"skill","summary":"Korean apartment and individual-house official price lookup through the public realtyprice.kr web data surface. Use when the user asks for 공동주택가격, 개별주택가격, 아파트 공시가격, 단독주택 공시가격, or housing official price history. This is not land official price, transaction price, or building register metadata.","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/housing-official-price"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/housing-official-price","installability":"discovery_only","source":"feed:skills-sh","linkKey":"housing-official-price"},{"id":"skill:nomadamas:hwp","name":"Hwp","slug":"hwp","kind":"skill","summary":"Use kordoc for agent-native HWP/HWPX document parsing, JSON extraction, diffing, form-field extraction, and Markdown→HWPX reverse conversion (read/convert only — for binary editing use rhwp-edit).","category":"Agent Skills","publisher":{"name":"nomadamas","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/nomadamas/k-skill/hwp"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/nomadamas/k-skill/hwp","installability":"discovery_only","source":"feed:skills-sh","linkKey":"skill:nomadamas:hwp"}]
