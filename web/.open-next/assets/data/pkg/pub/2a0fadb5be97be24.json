[{"id":"skill:ziniao-open:ziniao-access-policy","name":"Ziniao Access Policy","slug":"ziniao-access-policy","kind":"skill","summary":"紫鸟访问策略管理：网页访问规则、网页/网页分组、规则生效成员/账号、账号绑定策略的查询和维护。当前无快捷命令，全部通过 ziniao-cli api 直调。","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-access-policy"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-access-policy","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-access-policy"},{"id":"skill:ziniao-open:ziniao-account","name":"Ziniao Account","slug":"ziniao-account","kind":"skill","summary":"紫鸟账号（店铺）管理：店铺账号的查询、创建、修改、删除、授权和标签管理。当用户需要查看店铺账号列表、创建/修改/删除账号、管理账号授权或标签时使用。","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-account"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-account","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-account"},{"id":"skill:ziniao-open:ziniao-department","name":"Ziniao Department","slug":"ziniao-department","kind":"skill","summary":"紫鸟部门管理：部门的查询、创建、修改、删除和排序。当用户需要查看组织架构、创建/修改/删除部门、调整部门排序时使用。","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-department"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-department","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-department"},{"id":"skill:ziniao-open:ziniao-device","name":"Ziniao Device","slug":"ziniao-device","kind":"skill","summary":"紫鸟设备管理：代理设备（IP）的查询、添加、修改、绑定/解绑、购买续费和自动续费。当用户需要查看代理设备列表、添加/修改自有代理、绑定设备到店铺或管理设备费用时使用。","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-device"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-device","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-device"},{"id":"skill:ziniao-open:ziniao-openapi-explorer","name":"Ziniao Openapi Explorer","slug":"ziniao-openapi-explorer","kind":"skill","summary":"紫鸟 API 探索：当现有快捷命令无法满足需求时，通过通用 api 命令和已知路径清单探索紫鸟全部 73 个 API 接口。","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-openapi-explorer"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-openapi-explorer","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-openapi-explorer"},{"id":"skill:ziniao-open:ziniao-page","name":"Ziniao Page","slug":"ziniao-page","kind":"skill","summary":"Use when a request concerns a webpage running inside an already-opened 紫鸟/ZClaw store browser, including navigation, inspection, interaction, extraction, or screenshots. If the task starts by identifying or opening a store, use ziniao-store first.","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-page"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-page","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-page"},{"id":"skill:ziniao-open:ziniao-role","name":"Ziniao Role","slug":"ziniao-role","kind":"skill","summary":"紫鸟角色管理：角色的查询、创建、修改、分配和权限查看。当用户需要查看角色列表、创建/修改角色、将角色分配给员工或查看角色成员时使用。","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-role"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-role","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-role"},{"id":"skill:ziniao-open:ziniao-shared","name":"Ziniao Shared","slug":"ziniao-shared","kind":"skill","summary":"紫鸟 CLI 共享基础：应用配置初始化、ZClaw 客户端与 Bridge 就绪、统一 apiKey 认证、错误处理、输出格式和安全规则。当用户需要首次使用 ziniao-cli、配置 API Key、启动紫鸟客户端、登录 ZClaw 或排查认证/Bridge 问题时触发。","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-shared"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-shared","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-shared"},{"id":"skill:ziniao-open:ziniao-skill-maker","name":"Ziniao Skill Maker","slug":"ziniao-skill-maker","kind":"skill","summary":"创建 ziniao-cli 的自定义 Skill。当用户需要把紫鸟 API 操作封装成可复用的 Skill（包装原子 API 或编排多步流程）时使用。","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-skill-maker"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-skill-maker","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-skill-maker"},{"id":"skill:ziniao-open:ziniao-staff","name":"Ziniao Staff","slug":"ziniao-staff","kind":"skill","summary":"紫鸟员工管理：员工的查询、创建、修改、启用/禁用/删除和调岗。当用户需要查询员工信息、创建新员工、修改员工信息、启用/禁用/删除员工或调整员工部门时使用。","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-staff"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-staff","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-staff"},{"id":"skill:ziniao-open:ziniao-store","name":"Ziniao Store","slug":"ziniao-store","kind":"skill","summary":"Use when a request concerns the local 紫鸟/ZClaw browser, a store name or ID, listing/resolving/opening/reusing/closing a store browser, or a store-scoped task that starts from a store. Do not use for server-side account CRUD or for a webpage task on an already-open store.","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-store"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-store","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-store"},{"id":"skill:ziniao-open:ziniao-workflow-batch-account","name":"Ziniao Workflow Batch Account","slug":"ziniao-workflow-batch-account","kind":"skill","summary":"批量账号授权工作流：编排 account list + staff list + api 调用完成批量授权店铺给员工。适用于新员工入职时批量分配店铺权限。","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-workflow-batch-account"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-workflow-batch-account","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-workflow-batch-account"},{"id":"skill:ziniao-open:ziniao-workflow-store-patrol","name":"Ziniao Workflow Store Patrol","slug":"ziniao-workflow-store-patrol","kind":"skill","summary":"店铺巡检工作流：编排 store list + store open + page visit + page screenshot 完成店铺状态检查和截图巡检。适用于定期检查店铺页面状态、批量截图存档。","category":"Agent Skills","publisher":{"name":"ziniao-open","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/ziniao-open/skills/ziniao-workflow-store-patrol"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/ziniao-open/skills/ziniao-workflow-store-patrol","installability":"discovery_only","source":"feed:skills-sh","linkKey":"ziniao-workflow-store-patrol"}]
