[{"id":"skill:tjboudreaux:cc-thinking-skills","name":"Cc Thinking Skills","slug":"cc-thinking-skills","kind":"skill","summary":"Production-grade agent playbook for tjboudreaux/cc-thinking-skills","category":"Community Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://github.com/tjboudreaux/cc-thinking-skills"},"stars":null,"version":null,"skillSource":"https://github.com/tjboudreaux/cc-thinking-skills","installability":"discovery_only","source":"feed:voltagent-awesome-agent-skills","linkKey":"cc-thinking-skills"},{"id":"skill:tjboudreaux:thinking-bounded-rationality","name":"Thinking Bounded Rationality","slug":"thinking-bounded-rationality","kind":"skill","summary":"Use when search or investigation could run forever. Set an explicit good-enough threshold first, then stop at the first option that clears it.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-bounded-rationality"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-bounded-rationality","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-bounded-rationality"},{"id":"skill:tjboudreaux:thinking-circle-of-competence","name":"Thinking Circle Of Competence","slug":"thinking-circle-of-competence","kind":"skill","summary":"Use when a specific claim may lack grounding. Check evidence boundary, size wrongness cost, then answer, fetch, or abstain — never confabulate.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-circle-of-competence"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-circle-of-competence","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-circle-of-competence"},{"id":"skill:tjboudreaux:thinking-cynefin","name":"Thinking Cynefin","slug":"thinking-cynefin","kind":"skill","summary":"When the right response mode is unclear, classify the cause-effect domain first; decompose disorder.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-cynefin"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-cynefin","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-cynefin"},{"id":"skill:tjboudreaux:thinking-effectuation","name":"Thinking Effectuation","slug":"thinking-effectuation","kind":"skill","summary":"Under genuine uncertainty with no reliable forecast, inventory means, cap downside at affordable loss, act for commitments, and let goals emerge from controllable moves.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-effectuation"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-effectuation","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-effectuation"},{"id":"skill:tjboudreaux:thinking-first-principles","name":"Thinking First Principles","slug":"thinking-first-principles","kind":"skill","summary":"When a constraint is treated as fixed, separate physics from convention, keep only independently supported primitives, and rebuild the simplest solution that satisfies real constraints.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-first-principles"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-first-principles","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-first-principles"},{"id":"skill:tjboudreaux:thinking-five-whys-plus","name":"Thinking Five Whys Plus","slug":"thinking-five-whys-plus","kind":"skill","summary":"When a fault is localized and the proximate cause is known but the systemic root is not, chain evidence-linked whys with a counterfactual stop and a countermeasure.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-five-whys-plus"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-five-whys-plus","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-five-whys-plus"},{"id":"skill:tjboudreaux:thinking-jobs-to-be-done","name":"Thinking Jobs To Be Done","slug":"thinking-jobs-to-be-done","kind":"skill","summary":"Deciding what to build or why adoption fails. Recover the progress users hire a solution for under a circumstance, then rank by outcome and competing workarounds.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-jobs-to-be-done"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-jobs-to-be-done","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-jobs-to-be-done"},{"id":"skill:tjboudreaux:thinking-kepner-tregoe","name":"Thinking Kepner Tregoe","slug":"thinking-kepner-tregoe","kind":"skill","summary":"Use when a selective defect needs IS/IS-NOT difference analysis or a consequential option choice needs must/want weighting and adverse-consequence comparison.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-kepner-tregoe"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-kepner-tregoe","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-kepner-tregoe"},{"id":"skill:tjboudreaux:thinking-lindy-effect","name":"Thinking Lindy Effect","slug":"thinking-lindy-effect","kind":"skill","summary":"Use when longevity of a non-perishable option matters. Treat survival duration as a remaining-life prior, then check domain drift before favoring the proven.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-lindy-effect"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-lindy-effect","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-lindy-effect"},{"id":"skill:tjboudreaux:thinking-map-territory","name":"Thinking Map Territory","slug":"thinking-map-territory","kind":"skill","summary":"When a claim, doc, test, metric, or assumption conflicts with observed behavior, stop theorizing from the map and verify the live code or data; let territory overrule.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-map-territory"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-map-territory","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-map-territory"},{"id":"skill:tjboudreaux:thinking-margin-of-safety","name":"Thinking Margin Of Safety","slug":"thinking-margin-of-safety","kind":"skill","summary":"When provisioning, setting a limit, or committing an estimate under uncertainty, size a buffer to residual error and the cost of breach—not to the optimistic edge.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-margin-of-safety"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-margin-of-safety","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-margin-of-safety"},{"id":"skill:tjboudreaux:thinking-model-combination","name":"Thinking Model Combination","slug":"thinking-model-combination","kind":"skill","summary":"When one mental model leaves a material blind spot on a multi-domain or high-stakes problem, sequence complementary models with named roles and a conflict rule.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-model-combination"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-model-combination","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-model-combination"},{"id":"skill:tjboudreaux:thinking-model-router","name":"Thinking Model Router","slug":"thinking-model-router","kind":"skill","summary":"When unsure which thinking skill fits, map domain and problem type, then return NONE or one primary skill by default (at most three complementary).","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-model-router"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-model-router","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-model-router"},{"id":"skill:tjboudreaux:thinking-ooda","name":"Thinking Ooda","slug":"thinking-ooda","kind":"skill","summary":"Use under time pressure when the situation is still changing and you must act before certainty — cycle Observe→Orient→Decide→Act on ~70% confidence, then re-observe.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-ooda"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-ooda","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-ooda"},{"id":"skill:tjboudreaux:thinking-opportunity-cost","name":"Thinking Opportunity Cost","slug":"thinking-opportunity-cost","kind":"skill","summary":"Before committing scarce time, people, or money, name the best forgone use of those resources and the value delta of the chosen path versus that alternative.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-opportunity-cost"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-opportunity-cost","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-opportunity-cost"},{"id":"skill:tjboudreaux:thinking-pre-mortem","name":"Thinking Pre Mortem","slug":"thinking-pre-mortem","kind":"skill","summary":"Before committing to a plan or launch, assume it already failed and reason backward through concrete causes — convert failure paths into mitigations, gates, and stop checks.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-pre-mortem"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-pre-mortem","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-pre-mortem"},{"id":"skill:tjboudreaux:thinking-probabilistic","name":"Thinking Probabilistic","slug":"thinking-probabilistic","kind":"skill","summary":"Use when forecasting, estimating, or sizing risk — anchor on base rates, give ranges, update prior→likelihood→posterior on evidence, and factor unmeasured quantities into order-of-magnitude bounds.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-probabilistic"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-probabilistic","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-probabilistic"},{"id":"skill:tjboudreaux:thinking-red-team","name":"Thinking Red Team","slug":"thinking-red-team","kind":"skill","summary":"For authorized security review of code, auth, or APIs you control, model the attacker, map the attack surface, and report only findings with a reproducible exploit path and verified mitigation.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-red-team"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-red-team","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-red-team"},{"id":"skill:tjboudreaux:thinking-reversibility","name":"Thinking Reversibility","slug":"thinking-reversibility","kind":"skill","summary":"Before heavy deliberation, classify the decision as cheap or costly to undo; decide two-way doors fast and stage one-way doors to preserve options.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-reversibility"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-reversibility","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-reversibility"},{"id":"skill:tjboudreaux:thinking-scientific-method","name":"Thinking Scientific Method","slug":"thinking-scientific-method","kind":"skill","summary":"When a symptom has several plausible causes, rank falsifiable hypotheses and run the cheapest discriminating observation first; prefer least-assumptive survivors only after evidence fit.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-scientific-method"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-scientific-method","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-scientific-method"},{"id":"skill:tjboudreaux:thinking-second-order","name":"Thinking Second Order","slug":"thinking-second-order","kind":"skill","summary":"When a change has effects past the immediate fix—incentives, scale, feedback—trace consequence chains with timing and probability before committing.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-second-order"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-second-order","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-second-order"},{"id":"skill:tjboudreaux:thinking-socratic","name":"Thinking Socratic","slug":"thinking-socratic","kind":"skill","summary":"When a request is vague, assumption-laden, or \"obvious,\" ask the few load-bearing questions that expose hidden requirements before building or committing.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-socratic"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-socratic","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-socratic"},{"id":"skill:tjboudreaux:thinking-steel-manning","name":"Thinking Steel Manning","slug":"thinking-steel-manning","kind":"skill","summary":"Before rejecting a proposal or reflexively agreeing, build the strongest faithful opposing case, state agreement conditions, then update or reaffirm.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-steel-manning"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-steel-manning","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-steel-manning"},{"id":"skill:tjboudreaux:thinking-systems","name":"Thinking Systems","slug":"thinking-systems","kind":"skill","summary":"When behavior is emergent across components—fixes elsewhere break, loops/delays dominate—map boundary, stocks/flows, feedback, archetypes, then rank leverage.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-systems"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-systems","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-systems"},{"id":"skill:tjboudreaux:thinking-theory-of-constraints","name":"Thinking Theory Of Constraints","slug":"thinking-theory-of-constraints","kind":"skill","summary":"When throughput or latency is pipeline-limited, identify the single binding constraint and exploit, subordinate, elevate, then recheck—ignore non-constraints.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-theory-of-constraints"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-theory-of-constraints","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-theory-of-constraints"},{"id":"skill:tjboudreaux:thinking-thought-experiment","name":"Thinking Thought Experiment","slug":"thinking-thought-experiment","kind":"skill","summary":"When a real test is too rare, large, or irreversible, run a controlled counterfactual: isolate one variable, fix conditions, trace the mechanistic chain, and bound what the result implies.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-thought-experiment"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-thought-experiment","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-thought-experiment"},{"id":"skill:tjboudreaux:thinking-triz","name":"Thinking Triz","slug":"thinking-triz","kind":"skill","summary":"When two design requirements seem mutually exclusive, name the contradiction, separate conflicting states, then invent a concrete no-compromise resolution.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-triz"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-triz","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-triz"},{"id":"skill:tjboudreaux:thinking-via-negativa","name":"Thinking Via Negativa","slug":"thinking-via-negativa","kind":"skill","summary":"Use when the reflex is to add a feature, layer, or process. Prefer removing harmful or nonessential elements first, with an irreversibility guard before deletion.","category":"Agent Skills","publisher":{"name":"tjboudreaux","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-via-negativa"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/tjboudreaux/cc-thinking-skills/thinking-via-negativa","installability":"discovery_only","source":"feed:skills-sh","linkKey":"thinking-via-negativa"}]
