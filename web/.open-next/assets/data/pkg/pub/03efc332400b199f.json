sue"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/codestable/codestable/cs-issue","installability":"discovery_only","source":"feed:skills-sh","linkKey":"cs-issue"},{"id":"skill:codestable:cs-issue-analyze","name":"Cs Issue Analyze","slug":"cs-issue-analyze","kind":"skill","summary":"Deprecated 兼容入口：旧 cs-issue-analyze 调用用；转交 cs-issue --stage analyze。新请求不要主动选择。","category":"Agent Skills","publisher":{"name":"codestable","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/codestable/codestable/cs-issue-analyze"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/codestable/codestable/cs-issue-analyze","installability":"discovery_only","source":"feed:skills-sh","linkKey":"cs-issue-analyze"},{"id":"skill:codestable:cs-issue-fix","name":"Cs Issue Fix","slug":"cs-issue-fix","kind":"skill","summary":"Deprecated 兼容入口：旧 cs-issue-fix 调用用；转交 cs-issue --stage fix。新请求不要主动选择。","category":"Agent Skills","publisher":{"name":"codestable","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/codestable/codestable/cs-issue-fix"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/codestable/codestable/cs-issue-fix","installability":"discovery_only","source":"feed:skills-sh","linkKey":"cs-issue-fix"},{"id":"skill:codestable:cs-issue-report","name":"Cs Issue Report","slug":"cs-issue-report","kind":"skill","summary":"Deprecated 兼容入口：旧 cs-issue-report 调用用；转交 cs-issue --stage report。新请求不要主动选择。","category":"Agent Skills","publisher":{"name":"codestable","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/codestable/codestable/cs-issue-report"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/codestable/codestable/cs-issue-report","installability":"discovery_only","source":"feed:skills-sh","linkKey":"cs-issue-report"},{"id":"skill:codestable:cs-learn","name":"Cs Learn","slug":"cs-learn","kind":"skill","summary":"把踩过的坑或好做法沉淀成可检索的 learning 文档，两条轨道 pitfall（坑）/ knowledge（默认做法）。触发：用户说\"沉淀知识\"、\"learning\"、\"把这次经验记下来\"，或 acceptance / fix 收尾时推送。","category":"Agent Skills","publisher":{"name":"codestable","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/codestable/codestable/cs-learn"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/codestable/codestable/cs-learn","installability":"discovery_only","source":"feed:skills-sh","linkKey":"cs-learn"},{"id":"skill:codestable:cs-libdoc","name":"Cs Libdoc","slug":"cs-libdoc","kind":"skill","summary":"给库的公开表面（组件 / 函数 / 命令）逐条目生成参考文档，带清单追踪，支持单条目和批量。信息源是源码本身（与 guidedoc 任务导向不同）。触发：用户说\"写 API 文档\"、\"组件文档\"、\"libdoc\"，或 acceptance 后发现新增公开接口。","category":"Agent Skills","publisher":{"name":"codestable","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/codestable/codestable/cs-libdoc"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/codestable/codestable/cs-libdoc","installability":"discovery_only","source":"feed:skills-sh","linkKey":"cs-libdoc"},{"id":"skill:codestable:cs-note","name":"Cs Note","slug":"cs-note","kind":"skill","summary":"attention 短规则追加。触发：一两行、长期有效、每次会话都必须知道的项目规则；详细经验走 cs-keep，结构性决策走 cs-domain。","category":"Agent Skills","publisher":{"name":"codestable","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/codestable/codestable/cs-note"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/codestable/codestable/cs-note","installability":"discovery_only","source":"feed:skills-sh","linkKey":"cs-note"},{"id":"skill:codestable:cs-onboard","name":"Cs Onboard","slug":"cs-onboard","kind":"skill","summary":"仓库接入 CodeStable：创建最小骨架，或为 v1 存量项目做无损升级说明。","category":"Agent Skills","publisher":{"name":"codestable","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/codestable/codestable/cs-onboard"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/codestable/codestable/cs-onboard","installability":"discovery_only","source":"feed:skills-sh","linkKey":"skill:codestable:cs-onboard"},{"id":"skill:codestable:cs-refactor","name":"Cs Refactor","slug":"cs-refactor","kind":"skill","summary":"行为等价的重构、拆分、性能优化。会改变外部可观察行为的诉求走 cs-feat 或 cs-issue。","category":"Agent Skills","publisher":{"name":"codestable","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/codestable/codestable/cs-refactor"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/codestable/codestable/cs-refactor","installability":"discovery_only","source":"feed:skills-sh","linkKey":"cs-refactor"},{"id":"skill:codestable:cs-refactor-ff","name":"Cs Refactor Ff","slug":"cs-refactor-ff","kind":"skill","summary":"Deprecated 兼容入口：旧 cs-refactor-ff 调用用；转交 cs-refactor --mode fastforward。新请求不要主动选择。","category":"Agent Skills","publisher":{"name":"codestable","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/codestable/codestable/cs-refactor-ff"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/codestable/codestable/cs-refactor-ff","installability":"discovery_only","source":"feed:skills-sh","linkKey":"cs-refactor-ff"},{"id":"skill:codestable:cs-req","name":"Cs Req","slug":"cs-req","kind":"skill","summary":"能力愿景维护。触发：起草/回填/更新 requirements，或 design/acceptance 需要 req delta。不要用于单个功能实现方案(cs-feat design)、大需求拆解排期(cs-epic)、开放式发散讨论(cs-brainstorm)、领域术语/ADR建模(cs-domain)。","category":"Agent Skills","publisher":{"name":"codestable","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/codestable/codestable/cs-req"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/codestable/codestable/cs-req","installability":"discovery_only","source":"feed:skills-sh","linkKey":"cs-req"},{"id":"skill:codestable:cs-roadmap","name":"Cs Roadmap","slug":"cs-roadmap","kind":"skill","summary":"Deprecated 兼容入口：旧 cs-roadmap 调用用；转交 cs-epic --stage planning。新请求不要主动选择。","category":"Agent Skills","publisher":{"name":"codestable","verified":false,"p