[{"id":"skill:zenstory-ai:browser-cdp","name":"Browser Cdp","slug":"browser-cdp","kind":"skill","summary":"Use this skill when you need to control a Chrome browser via CDP (Chrome DevTools Protocol) to reuse existing login sessions. Covers: launching Chrome in debug mode, opening URLs, waiting for page load, evaluating JavaScript, taking snapshots, and extracting auth tokens. Trigger phrases: browser automation, CDP, agent-browser, 浏览器操作, 操作浏览器, Chrome CDP, 复用登录态, extract token from browser.","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/browser-cdp"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/browser-cdp","installability":"discovery_only","source":"feed:skills-sh","linkKey":"browser-cdp"},{"id":"skill:zenstory-ai:short-drama","name":"Short Drama","slug":"short-drama","kind":"skill","summary":"基于文件系统初始化和继续短剧或漫剧项目，提供 creator-first 五文档路由、本地 Dashboard、制作形态与 Look Development 决策。用户提出“创建/继续短剧项目”“看进度/下一步”“做 Look Development”“打开 dashboard/短剧创作台”“导出制作资料”，或任务跨多个创作阶段时使用；明确的写作、资产、提示词、分镜、剪辑或审查请求由对应子 skill 直接处理。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama","installability":"discovery_only","source":"feed:skills-sh","linkKey":"short-drama"},{"id":"skill:zenstory-ai:short-drama-assets","name":"Short Drama Assets","slug":"short-drama-assets","kind":"skill","summary":"从短剧剧本拆出人物/造型、地点/视图、道具/状态和跨场连续性，写成创作者可读的视觉设定。用户说“拆角色/场景/道具”“做资产设定”“判断复用还是新变体”“更新造型/道具状态”，或拿现成剧本直接做视觉资产准备时使用；不写图片提示词，不生成媒体。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-assets"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-assets","installability":"discovery_only","source":"feed:skills-sh","linkKey":"short-drama-assets"},{"id":"skill:zenstory-ai:short-drama-develop","name":"Short Drama Develop","slug":"short-drama-develop","kind":"skill","summary":"将中文小说、短剧或漫剧想法、梗概、改编材料、已有系列笔记或多集完整剧本发展成可追溯的改编方案、戏剧方向、创作简报、导演阐述、故事引擎与分集地图，并按题材与制作形态（画风）选择写法。用户提出“导入小说做短剧”“从多集整稿生成/补分集地图”“开发短剧/漫剧”“做故事设定/系列大纲/分集规划”“写导演阐述”“这个题材怎么写”“定画风/制作形态”“把这个点子变成短剧”或需要梳理人物冲突与集间交接时使用；已有单集剧本可直接进入写作、资产或审查流程，不强制补开发文件。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-develop"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-develop","installability":"discovery_only","source":"feed:skills-sh","linkKey":"short-drama-develop"},{"id":"skill:zenstory-ai:short-drama-edit","name":"Short Drama Edit","slug":"short-drama-edit","kind":"skill","summary":"将已生成的短剧镜头剪成成片，记录入出点、镜序、声音、字幕与交付规格。用于套剪、加字幕、统一响度、调整节奏或导出精修素材；需要补素材或修改故事时转回对应创作阶段。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-edit"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-edit","installability":"discovery_only","source":"feed:skills-sh","linkKey":"short-drama-edit"},{"id":"skill:zenstory-ai:short-drama-image-prompts","name":"Short Drama Image Prompts","slug":"short-drama-image-prompts","kind":"skill","summary":"为短剧人物、造型、地点、道具和状态编写或修改可直接复制的图片提示词 Markdown。用户提到角色设定图、三视图、参考图、场景板、道具图、风格帧、Look Development、状态变体或局部编辑提示词时使用；不生成图片，也不调用供应商。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-image-prompts"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-image-prompts","installability":"discovery_only","source":"feed:skills-sh","linkKey":"short-drama-image-prompts"},{"id":"skill:zenstory-ai:short-drama-novel-analyze","name":"Short Drama Novel Analyze","slug":"short-drama-novel-analyze","kind":"skill","summary":"把长篇小说、连载网文或多集散稿拆成可追溯的原著分析：章节索引、改编价值快评、逐章功能提取、剧情单元与节奏聚合、人物与设定归并，最后给出改编价值判定与分集候选，交给 $short-drama-develop 立契约。用户说“导入这本小说”“拆这本书”“分析原著”“这本书能不能改短剧”“先看看值不值得拆”“把长篇拆成分集候选”，或直接给出小说文件路径时使用。只做只读的结构化分析，不写剧本、不建资产、不生成媒体，也不替创作者决定改编方案。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-novel-analyze"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-novel-analyze","installability":"discovery_only","source":"feed:skills-sh","linkKey":"short-drama-novel-analyze"},{"id":"skill:zenstory-ai:short-drama-produce","name":"Short Drama Produce","slug":"short-drama-produce","kind":"skill","summary":"在创作者明确确认后，执行短剧项目的图片、视频、TTS/配音或时间线音乐生产任务，并把结果与精简运行记录落回项目。用户说“生成这张图/这段视频/这句配音/这段配乐”“开始跑图/跑视频/合成语音/生成音乐”“把已确认提示词送去生产”，或要求批量执行已确认媒体任务时使用；不负责创作提示词、镜头、台词、歌词或声音身份，也绝不把预览、继续、预算说明或既有接受状态当作本次付费生产确认。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-produce"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-produce","installability":"discovery_only","source":"feed:skills-sh","linkKey":"short-drama-produce"},{"id":"skill:zenstory-ai:short-drama-review","name":"Short Drama Review","slug":"short-drama-review","kind":"skill","summary":"审查短剧项目中的原著分析、故事、剧本、视觉设定、图片提示词、分镜、冻结关键帧、视频提示词和已有媒体。用户提出“审稿/检查剧本”“检查资产或连续性”“检查图片/视频提示词”“检查原著分析”“审查模板感”“根据生产观察做项目校准”时使用；只写审查问题、结论和修订要求，不代替 owner 修改来源文件。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-review"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-review","installability":"discovery_only","source":"feed:skills-sh","linkKey":"short-drama-review"},{"id":"skill:zenstory-ai:short-drama-storyboard","name":"Short Drama Storyboard","slug":"short-drama-storyboard","kind":"skill","summary":"把中文短剧剧本和视觉设定写成有戏剧职责、连续性边界与冻结关键帧提示词的分镜 Markdown。用户提出“拆分镜/设计镜头/做镜头表”“场次视觉计划/调度故事板”“比较导演方案”“写首帧/关键帧提示词”或检查轴线、站位、视线、持物连续性时使用；不生成媒体。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-storyboard"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-storyboard","installability":"discovery_only","source":"feed:skills-sh","linkKey":"short-drama-storyboard"},{"id":"skill:zenstory-ai:short-drama-video-prompts","name":"Short Drama Video Prompts","slug":"short-drama-video-prompts","kind":"skill","summary":"把短剧分镜和冻结关键帧写成可直接复制的视频提示词 Markdown，也可按用户要求写时间线配乐/主题曲意图。用户提到文生/图生视频动作、人物表演、运镜、口型、环境运动、镜头时长、起止状态、把分镜转成视频提示词或写配乐提示词时使用；不生成媒体、不创作歌词、不改分镜边界。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-video-prompts"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-video-prompts","installability":"discovery_only","source":"feed:skills-sh","linkKey":"short-drama-video-prompts"},{"id":"skill:zenstory-ai:short-drama-write","name":"Short Drama Write","slug":"short-drama-write","kind":"skill","summary":"编写或修订可拍摄的中文短剧、漫剧单集 Markdown 剧本，也负责保留作者原文地规范化现成剧本。用户提出“写/改一集短剧”“把大纲写成剧本”“优化场景/对白”“去模板感”“去 AI 味润色”“续写下一集”或提供剧本要求进入后续制作时使用；不负责资产、分镜、媒体提示词或终审。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-write"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/drama-skills/short-drama-write","installability":"discovery_only","source":"feed:skills-sh","linkKey":"short-drama-write"},{"id":"skill:zenstory-ai:story","name":"Story","slug":"story","kind":"skill","summary":"网络小说工具箱主入口。根据用户需求自动路由到对应 skill，并可管理作者习惯、启动本地 Dashboard。触发方式：/story、$story、/story dashboard、/网文、「我想写小说」「记住我的写作习惯」「打开工作台」「检查更新」。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/story"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/story","installability":"discovery_only","source":"feed:skills-sh","linkKey":"story"},{"id":"skill:zenstory-ai:story-cover","name":"Story Cover","slug":"story-cover","kind":"skill","summary":"小说封面生成。根据书名、作者名自动分析题材风格，调用 GPT-Image-2 生成含标题和署名的专业级网文封面；Codex CLI 优先使用内置 ImageGen，无需单独 API Key。触发方式：/story-cover、/封面、「帮我做个封面」「生成封面图」「做个小说封面」「封面设计」。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/story-cover"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/story-cover","installability":"discovery_only","source":"feed:skills-sh","linkKey":"story-cover"},{"id":"skill:zenstory-ai:story-deslop","name":"Story Deslop","slug":"story-deslop","kind":"skill","summary":"网文去AI味。检测并清除文本中的AI写作痕迹，让文字回归自然、非模板化。触发方式：/story-deslop、/去AI味、「去AI味」「这篇太AI了」「网文去AI味」。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/story-deslop"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/story-deslop","installability":"discovery_only","source":"feed:skills-sh","linkKey":"story-deslop"},{"id":"skill:zenstory-ai:story-import","name":"Story Import","slug":"story-import","kind":"skill","summary":"逆向导入已有小说。将已写好的小说（半成品或完本）反向解析为标准项目目录结构，兼容 story-long-write / story-short-write 后续写作流程；内部复用 story-long-analyze / story-short-analyze 的拆解管道，按篇幅自动分流。触发方式：/story-import、「导入小说」「反向解析」「导入」「把我的书导进来」。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/story-import"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/story-import","installability":"discovery_only","source":"feed:skills-sh","linkKey":"story-import"},{"id":"skill:zenstory-ai:story-long-analyze","name":"Story Long Analyze","slug":"story-long-analyze","kind":"skill","summary":"长篇网文拆文。保留黄金三章、逐章摘要、剧情、情绪、节奏、角色、设定和文风接口，以连续章节块完成因果、双时间线、关系与三维节奏分析；兼容旧成果直接使用、按需增强和断点续跑。含可选三层灵感库管道（灵感库、跨书灵感聚合、更新灵感库）。触发方式：/story-long-analyze、/长篇拆文、「帮我拆这本书」「拆这本书」「分析黄金三章」「深度拆解」「完整拆解」或提供小说文本文件路径。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/story-long-analyze"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/story-long-analyze","installability":"discovery_only","source":"feed:skills-sh","linkKey":"story-long-analyze"},{"id":"skill:zenstory-ai:story-long-scan","name":"Story Long Scan","slug":"story-long-scan","kind":"skill","summary":"长篇网文扫榜。分析起点、番茄、晋江等平台排行榜数据，提炼市场趋势与热门题材。触发方式：/story-long-scan、/长篇扫榜、「长篇什么火」「起点排行」。","category":"Agent Skills","publisher":{"name":"zenstory-ai","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/zenstory-ai/oh-story-claudecode/story-long-scan"},"stars":null,"version":null,