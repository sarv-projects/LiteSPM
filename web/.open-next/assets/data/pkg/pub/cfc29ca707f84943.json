[{"id":"skill:xtone:code-review","name":"Code Review","slug":"code-review","kind":"skill","summary":"PRやコード変更の汎用コードレビューを実施します。コードの品質、セキュリティ、設計を共通基準で評価し、approve/rejectを判断します。「このPRをレビュー」「コードレビューして」「マージ前チェック」などの依頼や、gh pr viewコマンドの実行時に使用してください。","category":"Agent Skills","publisher":{"name":"xtone","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/xtone/ai_development_tools/code-review"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/xtone/ai_development_tools/code-review","installability":"discovery_only","source":"feed:skills-sh","linkKey":"skill:xtone:code-review"},{"id":"skill:xtone:pr-triage","name":"Pr Triage","slug":"pr-triage","kind":"skill","summary":"PRの変更内容をトリアージし、変更カテゴリ分類・表層チェック・必要リファレンス判定を行います。結果を`.pr-triage.json`に出力し、後続のコードレビューフェーズで活用します。CI環境でのコスト最適化に使用してください。","category":"Agent Skills","publisher":{"name":"xtone","verified":false,"provenance":"awesome-list-claim","url":"https://www.skills.sh/xtone/ai_development_tools/pr-triage"},"stars":null,"version":null,"skillSource":"https://www.skills.sh/xtone/ai_development_tools/pr-triage","installability":"discovery_only","source":"feed:skills-sh","linkKey":"skill:xtone:pr-triage"}]
