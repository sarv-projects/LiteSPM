{"type":"route","meta":{"status":200,"headers":{"cache-control":"public, max-age=60, s-maxage=600, stale-while-revalidate=3600","content-type":"application/json","x-next-cache-tags":"_N_T_/layout,_N_T_/api/layout,_N_T_/api/litespm/layout,_N_T_/api/litespm/featured/layout,_N_T_/api/litespm/featured/route,_N_T_/api/litespm/featured"},"routeCache":{"key":"/route-cache/APP_ROUTE/27b844f81d48dc56fe7f07b15ae0702f8db8f85daae042f7eeebbd8bf050e864/$/api/litespm/featured","owner":{"kind":"APP_ROUTE","sourceRoute":"/api/litespm/featured/route"},"isFallback":false}},"body":"{\"groups\":[{\"id\":\"registry\",\"title\":\"MCP integrations\",\"blurb\":\"Explore MCP servers for development, documentation, design, and infrastructure. These listings originate from the official MCP registry.\",\"viewAllLabel\":\"Browse the registry\",\"viewAllHref\":\"/marketplace?source=builtin%3Amcp-registry&installable=1\"},{\"id\":\"skills\",\"title\":\"Featured agent skills\",\"blurb\":\"Start with practical skills for documents, presentations, design, and testing.\",\"viewAllLabel\":\"Browse agent skills\",\"viewAllHref\":\"/marketplace?category=Official%20Skills%20by&installable=1\"}],\"entries\":[{\"group\":\"registry\",\"groupTitle\":\"MCP integrations\",\"viewAllLabel\":\"Browse the registry\",\"viewAllHref\":\"/marketplace?source=builtin%3Amcp-registry&installable=1\",\"useCase\":\"Work with GitHub repositories, issues, and pull requests from your agent.\",\"id\":\"mcp:builtin:mcp-registry:io.github.github-github-mcp-server\",\"linkKey\":\"mcp:builtin:mcp-registry:io.github.github-github-mcp-server\",\"name\":\"GitHub\",\"kind\":\"mcp\",\"summary\":\"Connect AI assistants to GitHub - manage repos, issues, PRs, and workflows through natural language.\",\"category\":\"Developer Tools\",\"publisher\":\"github\",\"publisherVerified\":true,\"transport\":\"streamable-http\",\"version\":\"2.0.1\",\"installable\":true,\"availabilityLabel\":\"Remote endpoint\",\"source\":\"builtin:mcp-registry\"},{\"group\":\"registry\",\"groupTitle\":\"MCP integrations\",\"viewAllLabel\":\"Browse the registry\",\"viewAllHref\":\"/marketplace?source=builtin%3Amcp-registry&installable=1\",\"useCase\":\"Bring up-to-date library documentation into your coding workflow.\",\"id\":\"mcp:builtin:mcp-registry:io.github.upstash-context7\",\"linkKey\":\"mcp:builtin:mcp-registry:io.github.upstash-context7\",\"name\":\"Context7\",\"kind\":\"mcp\",\"summary\":\"Up-to-date code docs for any prompt\",\"category\":\"Developer Tools\",\"publisher\":\"upstash\",\"publisherVerified\":true,\"transport\":\"streamable-http\",\"version\":\"4.2.0\",\"installable\":true,\"availabilityLabel\":\"Remote endpoint\",\"source\":\"builtin:mcp-registry\"},{\"group\":\"registry\",\"groupTitle\":\"MCP integrations\",\"viewAllLabel\":\"Browse the registry\",\"viewAllHref\":\"/marketplace?source=builtin%3Amcp-registry&installable=1\",\"useCase\":\"Access Figma design context while implementing user interfaces.\",\"id\":\"mcp:builtin:mcp-registry:com.figma.mcp-mcp\",\"linkKey\":\"mcp:builtin:mcp-registry:com.figma.mcp-mcp\",\"name\":\"Figma MCP Server\",\"kind\":\"mcp\",\"summary\":\"The Figma MCP server brings Figma design context directly into your AI workflow.\",\"category\":\"Developer Tools\",\"publisher\":\"com.figma.mcp\",\"publisherVerified\":true,\"transport\":\"streamable-http\",\"version\":\"1.0.3\",\"installable\":true,\"availabilityLabel\":\"Remote endpoint\",\"source\":\"builtin:mcp-registry\"},{\"group\":\"registry\",\"groupTitle\":\"MCP integrations\",\"viewAllLabel\":\"Browse the registry\",\"viewAllHref\":\"/marketplace?source=builtin%3Amcp-registry&installable=1\",\"useCase\":\"Search and update supported Notion content from your agent.\",\"id\":\"mcp:builtin:mcp-registry:com.notion-mcp\",\"linkKey\":\"mcp:builtin:mcp-registry:com.notion-mcp\",\"name\":\"com.notion/mcp\",\"kind\":\"mcp\",\"summary\":\"Official Notion MCP server\",\"category\":\"Developer Tools\",\"publisher\":\"com.notion\",\"publisherVerified\":true,\"transport\":\"streamable-http\",\"version\":\"1.0.1\",\"installable\":true,\"availabilityLabel\":\"Remote endpoint\",\"source\":\"builtin:mcp-registry\"},{\"group\":\"registry\",\"groupTitle\":\"MCP integrations\",\"viewAllLabel\":\"Browse the registry\",\"viewAllHref\":\"/marketplace?source=builtin%3Amcp-registry&installable=1\",\"useCase\":\"Work with supported Cloudflare services and project information.\",\"id\":\"mcp:builtin:mcp-registry:com.cloudflare.mcp-mcp\",\"linkKey\":\"mcp:builtin:mcp-registry:com.cloudflare.mcp-mcp\",\"name\":\"com.cloudflare.mcp/mcp\",\"kind\":\"mcp\",\"summary\":\"Cloudflare MCP servers\",\"category\":\"Developer Tools\",\"publisher\":\"com.cloudflare.mcp\",\"publisherVerified\":true,\"transport\":\"streamable-http\",\"version\":\"1.0.0\",\"installable\":true,\"availabilityLabel\":\"Remote endpoint\",\"source\":\"builtin:mcp-registry\"},{\"group\":\"registry\",\"groupTitle\":\"MCP integrations\",\"viewAllLabel\":\"Browse the registry\",\"viewAllHref\":\"/marketplace?source=builtin%3Amcp-registry&installable=1\",\"useCase\":\"Access supported Postgres database and branch-management workflows.\",\"id\":\"mcp:builtin:mcp-registry:com.neon-mcp\",\"linkKey\":\"mcp:builtin:mcp-registry:com.neon-mcp\",\"name\":\"Neon\",\"kind\":\"mcp\",\"summary\":\"Official Neon MCP server for managing Neon projects and Lakebase Postgres databases.\",\"category\":\"Developer Tools\",\"publisher\":\"com.neon\",\"publisherVerified\":true,\"transport\":\"streamable-http\",\"version\":\"1.0.0\",\"installable\":true,\"availabilityLabel\":\"Remote endpoint\",\"source\":\"builtin:mcp-registry\"},{\"group\":\"skills\",\"groupTitle\":\"Featured agent skills\",\"viewAllLabel\":\"Browse agent skills\",\"viewAllHref\":\"/marketplace?category=Official%20Skills%20by&installable=1\",\"useCase\":\"Work with PDF documents, forms, and extracted content.\",\"id\":\"skill:anthropics:pdf\",\"linkKey\":\"skill:anthropics:pdf\",\"name\":\"Pdf\",\"kind\":\"skill\",\"summary\":\"Use this skill whenever the user wants to do anything with PDF files. This includes reading or extracting text/tables from PDFs, combining or merging multiple PDFs into one, splitting PDFs apart, rotating pages, adding watermarks, creating new PDFs, filling PDF forms, encrypting/decrypting PDFs, extracting images, and OCR on scanned PDFs to make them searchable. If the user mentions a .pdf file or asks to produce one, use this skill.\",\"category\":\"Official Skills by\",\"publisher\":\"anthropics\",\"publisherVerified\":false,\"transport\":null,\"version\":null,\"installable\":true,\"availabilityLabel\":\"Installs from source\",\"source\":\"feed:voltagent-awesome-agent-skills\"},{\"group\":\"skills\",\"groupTitle\":\"Featured agent skills\",\"viewAllLabel\":\"Browse agent skills\",\"viewAllHref\":\"/marketplace?category=Official%20Skills%20by&installable=1\",\"useCase\":\"Create and edit Word documents with structured formatting.\",\"id\":\"skill:anthropics:docx\",\"linkKey\":\"skill:anthropics:docx\",\"name\":\"Docx\",\"kind\":\"skill\",\"summary\":\"Use this skill whenever the user wants to create, read, edit, or manipulate Word documents (.docx files) or Word templates (.dotx files). Triggers include: any mention of 'Word doc', 'word document', '.docx', '.dotx', or requests to produce professional documents with formatting like tables of contents, headings, page numbers, or letterheads. Also use when extracting or reorganizing content from .docx or .dotx files, inserting or replacing images in documents, performing find-and-replace in Word files, working with tracked changes or comments, or converting content into a polished Word document. If the user asks for a 'report', 'memo', 'letter', 'template', or similar deliverable as a Word or .docx file, use this skill. Do NOT use for PDFs, spreadsheets, Google Docs, or general coding tasks unrelated to document generation.\",\"category\":\"Official Skills by\",\"publisher\":\"anthropics\",\"publisherVerified\":false,\"transport\":null,\"version\":null,\"installable\":true,\"availabilityLabel\":\"Installs from source\",\"source\":\"feed:voltagent-awesome-agent-skills\"},{\"group\":\"skills\",\"groupTitle\":\"Featured agent skills\",\"viewAllLabel\":\"Browse agent skills\",\"viewAllHref\":\"/marketplace?category=Official%20Skills%20by&installable=1\",\"useCase\":\"Create, inspect, and update spreadsheets with formulas and charts.\",\"id\":\"skill:anthropics:xlsx\",\"linkKey\":\"skill:anthropics:xlsx\",\"name\":\"Xlsx\",\"kind\":\"skill\",\"summary\":\"Use this skill any time a spreadsheet file is the primary input or output. This means any task where the user wants to: open, read, edit, or fix an existing .xlsx, .xlsm, .xltx, .csv, or .tsv file (e.g., adding columns, computing formulas, formatting, charting, cleaning messy data); create a new spreadsheet from scratch or from other data sources; or convert between tabular file formats. Trigger especially when the user references a spreadsheet file by name or path — even casually (like \\\"the xlsx in my downloads\\\") — and wants something done to it or produced from it. Also trigger for cleaning or restructuring messy tabular data files (malformed rows, misplaced headers, junk data) into proper spreadsheets. The deliverable must be a spreadsheet file. Do NOT trigger when the primary deliverable is a Word document, HTML report, standalone Python script, database pipeline, or Google Sheets API integration, even if tabular data is involved.\",\"category\":\"Official Skills by\",\"publisher\":\"anthropics\",\"publisherVerified\":false,\"transport\":null,\"version\":null,\"installable\":true,\"availabilityLabel\":\"Installs from source\",\"source\":\"feed:voltagent-awesome-agent-skills\"},{\"group\":\"skills\",\"groupTitle\":\"Featured agent skills\",\"viewAllLabel\":\"Browse agent skills\",\"viewAllHref\":\"/marketplace?category=Official%20Skills%20by&installable=1\",\"useCase\":\"Create and edit presentations using reusable slide workflows.\",\"id\":\"skill:anthropics:pptx\",\"linkKey\":\"skill:anthropics:pptx\",\"name\":\"Pptx\",\"kind\":\"skill\",\"summary\":\"Use this skill any time a .pptx or .potx file is involved in any way — as input, output, or both. This includes: creating slide decks, pitch decks, or presentations; reading, parsing, or extracting text from any .pptx or .potx file (even if the extracted content will be used elsewhere, like in an email or summary); editing, modifying, or updating existing presentations; combining or splitting slide files; working with templates (.potx), layouts, speaker notes, or comments. Trigger whenever the user mentions \\\"deck,\\\" \\\"slides,\\\" \\\"presentation,\\\" or references a .pptx or .potx filename, regardless of what they plan to do with the content afterward. If a .pptx or .potx file needs to be opened, created, or touched, use this skill.\",\"category\":\"Official Skills by\",\"publisher\":\"anthropics\",\"publisherVerified\":false,\"transport\":null,\"version\":null,\"installable\":true,\"availabilityLabel\":\"Installs from source\",\"source\":\"feed:voltagent-awesome-agent-skills\"},{\"group\":\"skills\",\"groupTitle\":\"Featured agent skills\",\"viewAllLabel\":\"Browse agent skills\",\"viewAllHref\":\"/marketplace?category=Official%20Skills%20by&installable=1\",\"useCase\":\"Design and improve interfaces with consistent visual direction.\",\"id\":\"skill:anthropics:frontend-design\",\"linkKey\":\"skill:anthropics:frontend-design\",\"name\":\"Frontend Design\",\"kind\":\"skill\",\"summary\":\"Guidance for distinctive, intentional visual design when building new UI or reshaping an existing one. Helps with aesthetic direction, typography, and making choices that don't read as templated defaults.\",\"category\":\"Official Skills by\",\"publisher\":\"anthropics\",\"publisherVerified\":false,\"transport\":null,\"version\":null,\"installable\":true,\"availabilityLabel\":\"Installs from source\",\"source\":\"feed:voltagent-awesome-agent-skills\"},{\"group\":\"skills\",\"groupTitle\":\"Featured agent skills\",\"viewAllLabel\":\"Browse agent skills\",\"viewAllHref\":\"/marketplace?category=Official%20Skills%20by&installable=1\",\"useCase\":\"Test web application behavior through browser-based workflows.\",\"id\":\"skill:anthropics:webapp-testing\",\"linkKey\":\"skill:anthropics:webapp-testing\",\"name\":\"Webapp Testing\",\"kind\":\"skill\",\"summary\":\"Toolkit for interacting with and testing local web applications using Playwright. Supports verifying frontend functionality, debugging UI behavior, capturing browser screenshots, and viewing browser logs.\",\"category\":\"Official Skills by\",\"publisher\":\"anthropics\",\"publisherVerified\":false,\"transport\":null,\"version\":null,\"installable\":true,\"availabilityLabel\":\"Installs from source\",\"source\":\"feed:voltagent-awesome-agent-skills\"}],\"releaseId\":\"rel-2026-11-05-03\"}"}