{"type":"route","meta":{"status":200,"headers":{"cache-control":"public, max-age=60, s-maxage=600, stale-while-revalidate=3600","content-type":"application/json","x-next-cache-tags":"_N_T_/layout,_N_T_/api/layout,_N_T_/api/litespm/layout,_N_T_/api/litespm/agents/layout,_N_T_/api/litespm/agents/route,_N_T_/api/litespm/agents"},"routeCache":{"key":"/route-cache/APP_ROUTE/a2141b1aee15ea9eca73d6b3a2d4d8a99a07652a6482e6bb028013a8351bc3a3/$/api/litespm/agents","owner":{"kind":"APP_ROUTE","sourceRoute":"/api/litespm/agents/route"},"isFallback":false}},"body":"{\"agents\":[{\"slug\":\"cursor\",\"pageId\":\"cursor\",\"name\":\"Cursor\",\"hostId\":\"cursor\",\"strings\":[\"Cursor\"],\"mcp\":{\"count\":39306,\"host\":\"Cursor\"},\"skill\":{\"count\":15482,\"host\":\"Cursor\"},\"plugin\":{\"count\":99,\"host\":\"Cursor\"},\"total\":54887,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Cursor is a coding agent for building ambitious software. You describe the change you want; it reads your project, edits files, runs shell commands, and lets you inspect the diff before you merge.\",\"interface\":\"AI code editor and coding agent (desktop app, CLI, and web)\",\"website\":\"https://cursor.com\",\"capabilities\":[\"Completes coding tasks, edits code and runs shell commands\",\"Plan Mode creates an implementation plan before writing any code\",\"Review changes: inspect diffs and run checks before you merge\"],\"skillOnly\":false},{\"slug\":\"vscode\",\"pageId\":\"vscode\",\"name\":\"Visual Studio Code (Copilot harness)\",\"hostId\":\"vscode\",\"strings\":[\"Visual Studio Code (Copilot harness)\"],\"mcp\":{\"count\":38562,\"host\":\"Visual Studio Code (Copilot harness)\"},\"skill\":null,\"plugin\":null,\"total\":38562,\"installable\":38562,\"topCategories\":[\"Developer Tools\",\"Finance & Crypto\",\"Knowledge & Memory\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"Code editor + AI agent\",\"summary\":\"Visual Studio Code is Microsoft's code editor with integrated agent workflows. LiteSPM writes the portable Copilot workspace .mcp.json format, which uses mcpServers and is read directly by Copilot harness sessions. The legacy .vscode/mcp.json Local-harness format is still supported by VS Code but deprecated in current guided setup and is not written by this adapter.\",\"interface\":\"Desktop code editor (Windows, macOS, Linux)\",\"website\":\"https://code.visualstudio.com\",\"capabilities\":[\"Writes the portable workspace .mcp.json format with a top-level mcpServers object\",\"Portable configuration supports local stdio and remote HTTP entries; SSE is not supported by this format\",\"The separate .vscode/mcp.json Local-harness format remains available in VS Code but is deprecated in guided setup and is not written by this adapter\"],\"skillOnly\":false},{\"slug\":\"github-copilot\",\"pageId\":\"github-copilot\",\"name\":\"GitHub Copilot\",\"hostId\":\"github-copilot\",\"strings\":[\"GitHub Copilot CLI\",\"GitHub Copilot\"],\"mcp\":{\"count\":39306,\"host\":\"GitHub Copilot CLI\"},\"skill\":{\"count\":15482,\"host\":\"GitHub Copilot\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"GitHub Copilot is an AI coding assistant built into your editor and GitHub itself. It suggests code as you type, answers questions about your code, and can take a task, make the changes, and open a pull request for your review.\",\"interface\":\"Editor extension, terminal CLI, desktop app, and GitHub.com\",\"website\":\"https://github.com/features/copilot\",\"capabilities\":[\"Inline code suggestions as you type in your IDE\",\"Reviews code and pull requests, with summaries and suggestions\",\"Agent researches a repository, edits files and prepares a pull request\"],\"skillOnly\":false},{\"slug\":\"cline\",\"pageId\":\"cline\",\"name\":\"Cline (VS Code Extension)\",\"hostId\":\"cline\",\"strings\":[\"Cline (VS Code Extension)\",\"Cline\"],\"mcp\":{\"count\":39306,\"host\":\"Cline (VS Code Extension)\"},\"skill\":{\"count\":15482,\"host\":\"Cline\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Cline is an open source coding agent that lives in your editor and terminal. It reads and writes files, runs terminal commands, and uses a browser, asking your approval before each action.\",\"interface\":\"VS Code extension (also CLI, desktop app, JetBrains plugin)\",\"website\":\"https://cline.bot\",\"capabilities\":[\"Reads and writes files, runs terminal commands, uses a browser\",\"Every action requires your explicit approval\",\"Runs as a VS Code extension, CLI, desktop app or JetBrains plugin\"],\"skillOnly\":false},{\"slug\":\"claude-code\",\"pageId\":\"claude-code\",\"name\":\"Claude Code CLI\",\"hostId\":\"claude-code\",\"strings\":[\"Claude Code CLI\",\"Claude Code\"],\"mcp\":{\"count\":39306,\"host\":\"Claude Code CLI\"},\"skill\":{\"count\":15482,\"host\":\"Claude Code\"},\"plugin\":{\"count\":378,\"host\":\"Claude Code CLI\"},\"total\":55166,\"installable\":55085,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Claude Code is a coding agent you run in your terminal. Point it at a project, ask in plain language, and it reads the codebase, edits files, runs commands, and works with your git history.\",\"interface\":\"Terminal CLI (also IDE extensions, desktop app, and web)\",\"website\":\"https://code.claude.com\",\"capabilities\":[\"Reads your codebase, edits files, and runs commands\",\"Works directly with git: stages changes, commits, branches, opens pull requests\",\"Connects to external tools and data via MCP\"],\"skillOnly\":false},{\"slug\":\"claude-desktop\",\"pageId\":\"claude-desktop\",\"name\":\"Claude Desktop\",\"hostId\":\"claude-desktop\",\"strings\":[\"Claude Desktop\"],\"mcp\":{\"count\":13746,\"host\":\"Claude Desktop\"},\"skill\":null,\"plugin\":null,\"total\":13746,\"installable\":13746,\"topCategories\":[\"Developer Tools\",\"Finance & Crypto\",\"Knowledge & Memory\"],\"configFormat\":\"json\",\"profileType\":\"Desktop AI assistant\",\"summary\":\"Claude Desktop is Anthropic's desktop application. It connects Claude conversations to local MCP servers, letting Claude work with tools and data exposed by applications on your computer.\",\"interface\":\"Desktop application (Windows, macOS, and Linux)\",\"website\":\"https://claude.ai/download\",\"capabilities\":[\"Connects to local MCP servers through a desktop configuration file\",\"Launches local servers over standard input/output\",\"Makes connected MCP tools and resources available in Claude conversations\"],\"skillOnly\":false},{\"slug\":\"codex\",\"pageId\":\"codex\",\"name\":\"OpenAI Codex CLI\",\"hostId\":\"codex\",\"strings\":[\"OpenAI Codex CLI\",\"Codex\"],\"mcp\":{\"count\":38562,\"host\":\"OpenAI Codex CLI\"},\"skill\":{\"count\":15482,\"host\":\"Codex\"},\"plugin\":{\"count\":65,\"host\":\"OpenAI Codex CLI\"},\"total\":54109,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"toml\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Codex is OpenAI's coding agent for your terminal. Start it in a project folder, describe the task, and it inspects files, makes edits, runs your local tools, and shows you the result to review.\",\"interface\":\"Terminal CLI\",\"website\":\"https://openai.com/codex/\",\"capabilities\":[\"Works against your local repository: inspects files, makes edits, runs tools already on your machine\",\"Code review mode reports prioritised findings without touching your working tree\",\"Runs non-interactively (codex exec) for scripts and CI\"],\"skillOnly\":false},{\"slug\":\"gemini-cli\",\"pageId\":\"gemini-cli\",\"name\":\"Gemini CLI\",\"hostId\":\"gemini-cli\",\"strings\":[\"Gemini CLI\"],\"mcp\":{\"count\":39306,\"host\":\"Gemini CLI\"},\"skill\":{\"count\":15482,\"host\":\"Gemini CLI\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Gemini CLI is an open source agent that brings Gemini into your terminal. Ask it about your code or hand it a task, and it edits files, runs shell commands, and pulls in web context as it works.\",\"interface\":\"Terminal CLI\",\"website\":\"https://geminicli.com\",\"capabilities\":[\"File operations, shell commands, web fetching and Google Search grounding\",\"MCP support for custom integrations\",\"Runs non-interactively in scripts with structured JSON output\"],\"skillOnly\":false},{\"slug\":\"zed\",\"pageId\":\"zed\",\"name\":\"Zed\",\"hostId\":\"zed\",\"strings\":[\"Zed\"],\"mcp\":{\"count\":38562,\"host\":\"Zed\"},\"skill\":{\"count\":15482,\"host\":\"Zed\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Zed is an open-source code editor with built-in collaboration and AI tools. Open the Agent Panel from the keyboard, describe the change you want, and its built-in agent works through your project while you keep editing.\",\"interface\":\"Open-source code editor\",\"website\":\"https://zed.dev\",\"capabilities\":[\"Prompt the built-in agent from the Agent Panel (Cmd+Shift+A / Ctrl+Shift+A)\",\"Inline assistance in the editor with Ctrl+Enter\",\"Configure AI providers through the AI overview, and add language and theme extensions\"],\"skillOnly\":false},{\"slug\":\"roo\",\"pageId\":\"roo\",\"name\":\"Roo Code\",\"hostId\":\"roo\",\"strings\":[\"Roo Code\"],\"mcp\":{\"count\":39306,\"host\":\"Roo Code\"},\"skill\":{\"count\":15482,\"host\":\"Roo Code\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Roo Code was an open-source AI coding agent for VS Code — model-agnostic, with actual file system access, terminal control, and multi-step workflows.\",\"interface\":\"VS Code extension\",\"website\":\"https://docs.roocode.com\",\"capabilities\":[\"Generates code from natural language descriptions and specs\",\"Refactors and debugs existing code, and writes or updates documentation\",\"Utilizes MCP servers for external tools and services\"],\"skillOnly\":false},{\"slug\":\"devin\",\"pageId\":\"devin\",\"name\":\"Devin\",\"hostId\":\"devin\",\"strings\":[\"Devin\",\"Devin for Terminal\"],\"mcp\":{\"count\":39306,\"host\":\"Devin\"},\"skill\":{\"count\":15482,\"host\":\"Devin for Terminal\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Devin is the AI software engineer that takes work off your team's plate before it lands in the backlog. Hand it a Linear or Jira ticket, an entire feature, a bug report or a chunk of app testing, and it writes, runs and tests the code while you watch in its embedded IDE and take over whenever you like. Reach it by tagging it in a Slack or Teams thread, delegating a task from the web app, or running Devin for Terminal locally for quick fixes and code exploration.\",\"interface\":\"Web application with an embedded IDE, plus Slack, Teams and a terminal CLI\",\"website\":\"https://devin.ai\",\"capabilities\":[\"Tackle many tasks in parallel: Linear/Jira tickets, entire features from scratch, and bug reports\",\"Follow Devin's work in the embedded IDE and take over mid-task\",\"Run Devin for Terminal locally for quick fixes, code exploration, and interactive coding\"],\"skillOnly\":false},{\"slug\":\"openhands\",\"pageId\":\"openhands\",\"name\":\"OpenHands\",\"hostId\":\"openhands\",\"strings\":[\"OpenHands\"],\"mcp\":{\"count\":39306,\"host\":\"OpenHands\"},\"skill\":{\"count\":15482,\"host\":\"OpenHands\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Run software engineering agents across your real workflows with OpenHands, an open source platform. Use the GUI for interactive agent sessions, the CLI for terminal-native work, or the SDK to embed agentic development in your own tools and products.\",\"interface\":\"Open source platform with a GUI, CLI and SDK\",\"website\":\"https://www.openhands.dev/\",\"capabilities\":[\"Run interactive agent sessions in the GUI\",\"Drive terminal-native workflows with the CLI\",\"Embed agents in your own tools with the SDK\"],\"skillOnly\":false},{\"slug\":\"grok-build\",\"pageId\":\"grok-build\",\"name\":\"Grok Build\",\"hostId\":\"grok-build\",\"strings\":[\"Grok Build (xAI Dev Tool)\",\"Grok\",\"Grok Build\"],\"mcp\":{\"count\":38562,\"host\":\"Grok Build (xAI Dev Tool)\"},\"skill\":{\"count\":15482,\"host\":\"Grok Build\"},\"plugin\":{\"count\":31,\"host\":\"Grok Build\"},\"total\":54075,\"installable\":54072,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"toml\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Grok Build is xAI's coding agent that runs in your terminal. Give it a task in a project folder and it works through your code in an interactive TUI, or run it headlessly from a script.\",\"interface\":\"Terminal CLI (interactive TUI, headless, or ACP)\",\"website\":\"https://x.ai/build\",\"capabilities\":[\"Interactive fullscreen TUI with mouse support\",\"Headless mode (grok -p) for scripts, bots and automation\",\"Loads skills, plugins, hooks and MCP servers; supports custom models\"],\"skillOnly\":false},{\"slug\":\"pi-agent\",\"pageId\":\"pi-agent\",\"name\":\"Pi\",\"hostId\":\"pi-agent\",\"strings\":[\"Pi Agent (Terminal Agent)\",\"Pi\",\"Pi Agent\"],\"mcp\":{\"count\":38562,\"host\":\"Pi Agent (Terminal Agent)\"},\"skill\":{\"count\":15482,\"host\":\"Pi Agent\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Pi is an extensible AI agent that works from your terminal. Give it a goal and a working folder, and it inspects files, runs commands, edits content, and works through multi-step tasks. Use it as is, prompt it to adapt itself to your workflow, or build on it with the SDK.\",\"interface\":\"Terminal CLI\",\"website\":\"https://pi.dev\",\"capabilities\":[\"Inspects files, runs commands and edits content through multi-step tasks\",\"Resume or branch a saved session without losing history\",\"Print mode, JSON event stream and RPC mode for scripted and embedded use\"],\"skillOnly\":false},{\"slug\":\"opencode\",\"pageId\":\"opencode\",\"name\":\"OpenCode CLI\",\"hostId\":\"opencode\",\"strings\":[\"OpenCode CLI\",\"OpenCode\"],\"mcp\":{\"count\":38562,\"host\":\"OpenCode CLI\"},\"skill\":{\"count\":15482,\"host\":\"OpenCode\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"OpenCode is an open source AI coding agent that runs in your terminal. Open it in a project, ask it to explain code or build a feature, and it moves between a plan you approve and edits it makes.\",\"interface\":\"Terminal CLI (also desktop app and IDE extension)\",\"website\":\"https://opencode.ai\",\"capabilities\":[\"Plan mode proposes how it will implement a feature before it touches files\",\"Runs /init to analyse your project and create an AGENTS.md file\",\"Works with any LLM provider you configure API keys for\"],\"skillOnly\":false},{\"slug\":\"antigravity\",\"pageId\":\"antigravity\",\"name\":\"Antigravity\",\"hostId\":\"antigravity\",\"strings\":[\"Antigravity\"],\"mcp\":{\"count\":39306,\"host\":\"Antigravity\"},\"skill\":{\"count\":15482,\"host\":\"Antigravity\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Antigravity is Google's agent-first desktop app for building with AI agents. It is your command center for running several local agents in parallel: group conversations into Projects, work across multiple workspaces, and let long-running workflows run in the background while other agents research, implement and test.\",\"interface\":\"Desktop application (macOS, Windows, Linux, Googlebook)\",\"website\":\"https://antigravity.google\",\"capabilities\":[\"Orchestrates multiple subagents across all your environments\",\"Groups conversations into Projects and works across multiple workspaces\",\"Automates routine tasks with scheduled messages\"],\"skillOnly\":false},{\"slug\":\"antigravity-cli\",\"pageId\":\"antigravity-cli\",\"name\":\"Antigravity CLI\",\"hostId\":\"antigravity-cli\",\"strings\":[\"Antigravity CLI\"],\"mcp\":{\"count\":39306,\"host\":\"Antigravity CLI\"},\"skill\":{\"count\":15482,\"host\":\"Antigravity CLI\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Antigravity CLI is the terminal-first surface for working with Antigravity agents. Open a fresh terminal, run the launcher, and drive everything from your keyboard — it carries a minimal resource footprint designed for speed, SSH sessions and remote work.\",\"interface\":\"Terminal user interface (TUI), keyboard-first\",\"website\":\"https://antigravity.google/product/antigravity-cli\",\"capabilities\":[\"Edit, orchestrate and build in natural language from the terminal\",\"Runs subagents in parallel so larger tasks get tackled faster\",\"Slash commands reach plugins, MCP, skills and hooks configurations instantly\"],\"skillOnly\":false},{\"slug\":\"qwen-code\",\"pageId\":\"qwen-code\",\"name\":\"Qwen Code\",\"hostId\":\"qwen-code\",\"strings\":[\"Qwen Code\"],\"mcp\":{\"count\":39306,\"host\":\"Qwen Code\"},\"skill\":{\"count\":15482,\"host\":\"Qwen Code\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Qwen Code is the open-source AI coding agent for your terminal, editor, desktop, browser, and chat. Open it in a project, describe what you want built, and it plans the work, writes and edits code, runs commands, and reaches external tools over MCP.\",\"interface\":\"Terminal CLI (also desktop app, web UI, IDE plugins, and chat)\",\"website\":\"https://qwenlm.github.io/qwen-code-docs/\",\"capabilities\":[\"Agentic out of the box: Auto-Memory, Auto-Skills, SubAgents, Agent Teams, and MCP\",\"Speaks multiple protocols — OpenAI, Anthropic, Gemini, and Qwen APIs, plus local models like Ollama and vLLM\",\"Goes beyond the terminal with IDE plugins, a desktop app, a web UI, SDKs, and chat integrations\"],\"skillOnly\":false},{\"slug\":\"kimi-code-cli\",\"pageId\":\"kimi-code-cli\",\"name\":\"Kimi Code CLI\",\"hostId\":\"kimi-code-cli\",\"strings\":[\"Kimi Code CLI\"],\"mcp\":{\"count\":39306,\"host\":\"Kimi Code CLI\"},\"skill\":{\"count\":15482,\"host\":\"Kimi Code CLI\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Kimi Code CLI is an AI agent that runs in the terminal and carries out software development tasks and day-to-day terminal operations — reading and modifying code, running shell commands, searching files and fetching web pages. It plans and adjusts its next steps from the feedback it gets as it works.\",\"interface\":\"Terminal CLI (interactive TUI)\",\"website\":\"https://www.kimi.com/code\",\"capabilities\":[\"Writes and modifies code — new features, bug fixes, refactors\",\"Explores an unfamiliar codebase and answers questions about it\",\"Asks for confirmation before it modifies files or runs shell commands\"],\"skillOnly\":false},{\"slug\":\"tabnine-cli\",\"pageId\":\"tabnine-cli\",\"name\":\"Tabnine CLI\",\"hostId\":\"tabnine-cli\",\"strings\":[\"Tabnine CLI\"],\"mcp\":{\"count\":39306,\"host\":\"Tabnine CLI\"},\"skill\":{\"count\":15482,\"host\":\"Tabnine CLI\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Tabnine CLI is an AI-powered coding assistant that runs directly in your terminal. Ask it a question about your project, request a code review, or hand it a task, and it gathers context from your files, runs its built-in tools, and answers back in the terminal.\",\"interface\":\"Terminal CLI\",\"website\":\"https://docs.tabnine.com/main/getting-started/tabnine-cli\",\"capabilities\":[\"Interactive chat in the terminal, plus a non-interactive mode for scripts and automation\",\"Built-in file operations and shell commands, with remote code search across large codebases\",\"Code review, code generation and refactoring from plain-language prompts\"],\"skillOnly\":false},{\"slug\":\"augment\",\"pageId\":\"augment\",\"name\":\"Auggie CLI\",\"hostId\":\"augment\",\"strings\":[\"Augment\",\"Auggie CLI\"],\"mcp\":{\"count\":39306,\"host\":\"Augment\"},\"skill\":{\"count\":15482,\"host\":\"Augment\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Auggie CLI puts the power of Augment's agent and context engine in your terminal. Run it as a full-screen interactive session alongside your favorite editor, or hand it a prompt in print mode and let it act in your scripts and automated workflows.\",\"interface\":\"Terminal CLI (interactive TUI plus non-interactive print mode)\",\"website\":\"https://www.augmentcode.com\",\"capabilities\":[\"Build features and debug issues with a standalone interactive agent\",\"Get instant feedback, insight and suggestions for your PRs and builds\",\"Triage customer issues and alerts from your observability stack\"],\"skillOnly\":false},{\"slug\":\"cortex\",\"pageId\":\"cortex\",\"name\":\"CoCo CLI\",\"hostId\":\"cortex\",\"strings\":[\"Cortex Code\",\"CoCo CLI\"],\"mcp\":{\"count\":39306,\"host\":\"Cortex Code\"},\"skill\":{\"count\":15482,\"host\":\"Cortex Code\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"CoCo CLI is the command-line way to use Snowflake CoCo, the AI agent built into the Snowflake platform for data engineering, analytics, machine learning and agent-building work. It runs an autonomous agent framework against your own Snowflake account, with an understanding of its role-based access control, schemas and best practices.\",\"interface\":\"Command line, desktop IDE, and Snowsight (web)\",\"website\":\"https://www.snowflake.com/en/product/features/coco/\",\"capabilities\":[\"Works directly against your Snowflake environment, aware of its RBAC, schemas and conventions\",\"Takes on data analysis, machine learning and data engineering tasks\",\"Reaches external tools and data through Model Context Protocol servers\"],\"skillOnly\":false},{\"slug\":\"rovodev\",\"pageId\":\"rovodev\",\"name\":\"Rovo Dev\",\"hostId\":\"rovodev\",\"strings\":[\"Rovo Dev\"],\"mcp\":{\"count\":39306,\"host\":\"Rovo Dev\"},\"skill\":{\"count\":15482,\"host\":\"Rovo Dev\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Rovo Dev is Atlassian's AI coding agent for software teams: plan, generate, and review code in your terminal, IDE, Bitbucket, and GitHub. It plans against knowledge from across the Atlassian platform, turns Jira work items into code, and validates changes against acceptance criteria in Jira.\",\"interface\":\"Terminal CLI, IDE (VS Code), Bitbucket, and GitHub\",\"website\":\"https://www.atlassian.com/software/rovo-dev\",\"capabilities\":[\"Plans code changes from requirements and knowledge from across the Atlassian platform\",\"Generates implementation aligned to those plans, including refactoring, tests, and docs\",\"Reviews code and validates changes against acceptance criteria in Jira\"],\"skillOnly\":false},{\"slug\":\"posit-assistant\",\"pageId\":\"posit-assistant\",\"name\":\"Posit Assistant\",\"hostId\":\"posit-assistant\",\"strings\":[\"Posit Assistant\"],\"mcp\":{\"count\":38562,\"host\":\"Posit Assistant\"},\"skill\":{\"count\":15482,\"host\":\"Posit Assistant\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Posit Assistant is the agentic harness for data science. Load a dataset and ask questions in plain language, describe the dashboard you want and get a working app, or paste an error and let it pinpoint and fix the bug — working inside Positron, RStudio, or your terminal, connected to live R and Python runtimes.\",\"interface\":\"Positron, RStudio, and the terminal\",\"website\":\"https://assistant.posit.co\",\"capabilities\":[\"Explores your data from a plain-language question, with summary statistics and publication-ready visualizations\",\"Scaffolds a working dashboard from a description, wiring up layouts and inputs\",\"Reads your session context, loaded packages, and variables to debug and fix code\"],\"skillOnly\":false},{\"slug\":\"codearts-agent\",\"pageId\":\"codearts-agent\",\"name\":\"CodeArts Agent\",\"hostId\":\"codearts-agent\",\"strings\":[\"CodeArts Agent\"],\"mcp\":{\"count\":38562,\"host\":\"CodeArts Agent\"},\"skill\":{\"count\":15482,\"host\":\"CodeArts Agent\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Huawei Cloud CodeArts Agent is a coding agent built for real-world software engineering. It understands project context and coding intent and handles R&D tasks such as requirements analysis, coding, debugging and optimization, and testing — and, through natural language interaction, lets anyone create applications, tools, content and automated workflows.\",\"interface\":\"AI-native IDE, VS Code/JetBrains extensions, and a CLI (TUI and command line)\",\"website\":\"https://www.huaweicloud.com/intl/en-us/product/codearts/ai.html\",\"capabilities\":[\"Converts natural language descriptions into executable tasks through intelligent planning\",\"Generates, analyzes, troubleshoots, tests and verifies your code\",\"Ships as an IDE, VS Code/JetBrains extensions, and a CLI for terminal scenarios\"],\"skillOnly\":false},{\"slug\":\"bob\",\"pageId\":\"bob\",\"name\":\"IBM Bob\",\"hostId\":\"bob\",\"strings\":[\"IBM Bob\"],\"mcp\":{\"count\":38562,\"host\":\"IBM Bob\"},\"skill\":{\"count\":15482,\"host\":\"IBM Bob\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"IBM Bob is an AI-powered development partner that works right alongside you in your codebase to help you build quality software faster. Explain what you want in natural language and it generates the implementation in context, or spawn focused agents and subagents that run long-running tasks in parallel in the background.\",\"interface\":\"IDE extension (plus Bob Shell for the terminal)\",\"website\":\"https://bob.ibm.com\",\"capabilities\":[\"Spawns focused agents and subagents that contribute to your code base in parallel\",\"Literate Coding turns a natural-language explanation into the implementation in context\",\"Bob Shell brings the agent to your command line for scripts and CI/CD pipelines\"],\"skillOnly\":false},{\"slug\":\"aider-desk\",\"pageId\":\"aider-desk\",\"name\":\"AiderDesk\",\"hostId\":\"aider-desk\",\"strings\":[\"AiderDesk\"],\"mcp\":{\"count\":38562,\"host\":\"AiderDesk\"},\"skill\":{\"count\":15482,\"host\":\"AiderDesk\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"AiderDesk is a desktop app built on top of aider, the terminal pair programmer. You work on a codebase in its window while an agent plans and makes changes, and you review every change as a diff before it lands.\",\"interface\":\"Desktop app\",\"website\":\"https://aiderdesk.hotovo.com\",\"capabilities\":[\"A diff viewer and tool approvals show every proposed change before it lands\",\"Git worktrees isolate risky work so you can merge back when ready\",\"Agent mode plans and executes tasks with your approval; supports MCP servers\"],\"skillOnly\":false},{\"slug\":\"codebuddy\",\"pageId\":\"codebuddy\",\"name\":\"CodeBuddy\",\"hostId\":\"codebuddy\",\"strings\":[\"CodeBuddy\"],\"mcp\":{\"count\":39306,\"host\":\"CodeBuddy\"},\"skill\":{\"count\":15482,\"host\":\"CodeBuddy\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"CodeBuddy Code is Tencent Cloud’s terminal coding assistant. Describe a development task in natural language and work through code changes, tests, debugging, and deployment from your terminal.\",\"interface\":\"Terminal CLI\",\"website\":\"https://www.codebuddy.ai\",\"capabilities\":[\"Edits files, runs commands and tests, and works with Git\",\"Connects to external services through MCP\",\"Supports shell pipelines and script-based workflows\"],\"skillOnly\":false},{\"slug\":\"qoder\",\"pageId\":\"qoder\",\"name\":\"Qoder\",\"hostId\":\"qoder\",\"strings\":[\"Qoder\"],\"mcp\":{\"count\":39306,\"host\":\"Qoder\"},\"skill\":{\"count\":15482,\"host\":\"Qoder\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Qoder is an agentic platform for real work, bringing AI into software development, terminal workflows, managed cloud execution, and everyday productivity. Instead of stopping at a suggestion, it understands the task and its context, plans the work, uses tools to execute it, verifies the result, and iterates until the deliverable is ready.\",\"interface\":\"Agentic platform — desktop workspace, IDE, JetBrains plugin, terminal CLI, and cloud agents\",\"website\":\"https://qoder.com\",\"capabilities\":[\"Gives agents persistent context from code, knowledge, rules, tools, and files\",\"Runs multi-step work end to end — plan, execute, verify, iterate — keeping review points\",\"Covers the whole family: Qoder IDE, Qoder CLI, JetBrains plugin, and cloud agents\"],\"skillOnly\":false},{\"slug\":\"qoder-cn\",\"pageId\":\"qoder-cn\",\"name\":\"Qoder CN\",\"hostId\":\"qoder-cn\",\"strings\":[\"Qoder CN\"],\"mcp\":{\"count\":39306,\"host\":\"Qoder CN\"},\"skill\":{\"count\":15482,\"host\":\"Qoder CN\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Qoder CN is Alibaba Cloud's AI agent product series, covering software development and everyday office work in one family — a desktop workspace, an IDE, a JetBrains plugin, and a terminal CLI. It runs on domestic models such as GLM, DeepSeek, Kimi, and MiniMax, deployed end to end on China's clouds to meet data-security and compliance requirements. The series was renamed from Tongyi Lingma (通义灵码) on May 20, 2026.\",\"interface\":\"Desktop workspace, IDE, JetBrains plugin, and terminal CLI\",\"website\":\"https://qoder.cn\",\"capabilities\":[\"Runs on mainstream domestic models, fully deployed in-country for data security and compliance\",\"Ships a desktop workspace, an IDE, a JetBrains plugin, and a terminal CLI\",\"Offers enterprise options for finance and government: dedicated editions, private knowledge enhancement, dedicated VPC deployment\"],\"skillOnly\":false},{\"slug\":\"amp\",\"pageId\":\"amp\",\"name\":\"Amp\",\"hostId\":\"amp\",\"strings\":[\"Amp\"],\"mcp\":{\"count\":39306,\"host\":\"Amp\"},\"skill\":{\"count\":15482,\"host\":\"Amp\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Amp is a coding agent you run from the terminal, the web, or its desktop and mobile apps. Give it a task and it inspects and changes your code, and can keep working on a remote machine after you close your laptop.\",\"interface\":\"Terminal CLI, web app, and Mac/iPhone/iPad apps\",\"website\":\"https://ampcode.com\",\"capabilities\":[\"Runs on your own machine from the CLI, or on ampcode.com with no install\",\"Orbs: a remote machine per thread that keeps working after you close your laptop\",\"Connects to MCP servers; extended with skills and plugins\"],\"skillOnly\":false},{\"slug\":\"command-code\",\"pageId\":\"command-code\",\"name\":\"Command Code\",\"hostId\":\"command-code\",\"strings\":[\"Command Code\"],\"mcp\":{\"count\":38562,\"host\":\"Command Code\"},\"skill\":{\"count\":15482,\"host\":\"Command Code\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Command Code is a coding agent you run in your terminal. Install it with npm, open a project, and it reads your code, edits files, runs commands, and connects to external services through MCP servers.\",\"interface\":\"Terminal CLI\",\"website\":\"https://commandcode.ai\",\"capabilities\":[\"Connects to MCP servers so you can query databases, drive issue trackers, and call APIs from a session\",\"Ships with planning, skills, hooks, memory, background tasks, and git worktree support\",\"Imports MCP servers, skills, agents, and memory from Claude Code, Codex, Cursor, OpenCode, and Gemini CLI\"],\"skillOnly\":false},{\"slug\":\"deepagents\",\"pageId\":\"deepagents\",\"name\":\"Deep Agents Code\",\"hostId\":\"deepagents\",\"strings\":[\"Deep Agents\",\"Deep Agents Code\"],\"mcp\":{\"count\":39306,\"host\":\"Deep Agents\"},\"skill\":{\"count\":15482,\"host\":\"Deep Agents\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Deep Agents Code (dcode) is LangChain's open source coding agent for the terminal, built on the Deep Agents SDK. It works with any large language model, carries memory between conversations, and gates code execution behind approval controls.\",\"interface\":\"Terminal coding agent (dcode)\",\"website\":\"https://docs.langchain.com/oss/deepagents/code/overview\",\"capabilities\":[\"Works with any large language model, and can switch provider or model\",\"Persistent memory carries context across conversations\",\"Approval controls gate code execution; skills shape how it behaves\"],\"skillOnly\":false},{\"slug\":\"droid\",\"pageId\":\"droid\",\"name\":\"Droid\",\"hostId\":\"droid\",\"strings\":[\"Droid\"],\"mcp\":{\"count\":39306,\"host\":\"Droid\"},\"skill\":{\"count\":15482,\"host\":\"Droid\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Install Droid, delegate your first task, and scale from a single session to an automated SDLC. Delegate a task, review the diff, and merge it from the Factory App or your terminal, or put code review, QA and documentation on autopilot across your repos. Droid runs the same everywhere, so pick the surface that fits: the desktop app, the CLI, or a browser with nothing to install.\",\"interface\":\"Desktop app, terminal CLI, and web and mobile sessions\",\"website\":\"https://factory.com\",\"capabilities\":[\"Delegate a task, review the diff, and merge from the App or your terminal\",\"Put code review, QA, and documentation on autopilot across your repos\",\"Run the same Droid from the desktop app, the CLI, or any browser\"],\"skillOnly\":false},{\"slug\":\"firebender\",\"pageId\":\"firebender\",\"name\":\"Firebender\",\"hostId\":\"firebender\",\"strings\":[\"Firebender\"],\"mcp\":{\"count\":39306,\"host\":\"Firebender\"},\"skill\":{\"count\":15482,\"host\":\"Firebender\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Say what you want and Firebender builds it for you in a collaborative way, right inside your IDE. It runs as a coding agent deeply integrated into Android Studio and JetBrains IDEs, and it connects to your favorite tools and services. Get it from the JetBrains plugin marketplace and onboard in a few minutes.\",\"interface\":\"Plugin for Android Studio and JetBrains IDEs\",\"website\":\"https://firebender.com\",\"capabilities\":[\"Build what you ask for collaboratively inside the IDE\",\"Run inside Android Studio and JetBrains IDEs\",\"Connect to your favorite tools and services\"],\"skillOnly\":false},{\"slug\":\"forgecode\",\"pageId\":\"forgecode\",\"name\":\"ForgeCode\",\"hostId\":\"forgecode\",\"strings\":[\"ForgeCode\"],\"mcp\":{\"count\":39306,\"host\":\"ForgeCode\"},\"skill\":{\"count\":15482,\"host\":\"ForgeCode\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Run ForgeCode in your terminal and let it read files, write patches, run commands, and keep context across the whole session. Work in three ways: an interactive TUI for multi-step work, a one-shot CLI run with -p, or the zsh plugin's : prefix for quick prompts. Switch between the forge, sage and muse agents to implement features, map architecture, or write an implementation plan.\",\"interface\":\"Terminal: interactive TUI, one-shot CLI mode, and a zsh plugin mode\",\"website\":\"https://forgecode.dev\",\"capabilities\":[\"Read files, write patches, and run commands while holding context across the session\",\"Work in an interactive TUI, one-shot CLI mode, or the zsh : prefix\",\"Pick the forge, sage, or muse agent for implementation, research, or planning\"],\"skillOnly\":false},{\"slug\":\"astrbot\",\"pageId\":\"astrbot\",\"name\":\"AstrBot\",\"hostId\":\"astrbot\",\"strings\":[\"AstrBot\"],\"mcp\":{\"count\":39306,\"host\":\"AstrBot\"},\"skill\":{\"count\":15482,\"host\":\"AstrBot\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"AstrBot is an open-source, cross-platform AI assistant that runs directly in your chat apps. Deploy it on your own machine, connect it to QQ, Telegram, Discord, Slack and the rest, and it enables automation and smart collaboration with flexible agent orchestration.\",\"interface\":\"Self-hosted server (one-click launcher, desktop app, Docker, uv or pip)\",\"website\":\"https://astrbot.app\",\"capabilities\":[\"Native MCP support to expand AI capabilities without hard limits\",\"Isolated agent sandbox runtimes to keep the system safe and stable\",\"1000+ community plugins covering productivity, group operations and integrations\"],\"skillOnly\":false},{\"slug\":\"crush\",\"pageId\":\"crush\",\"name\":\"Crush\",\"hostId\":\"crush\",\"strings\":[\"Crush\"],\"mcp\":{\"count\":39306,\"host\":\"Crush\"},\"skill\":{\"count\":15482,\"host\":\"Crush\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Crush is a terminal-based AI coding assistant built by Charm. It connects to your choice of LLM and gives it tools to read, write, and execute code, with LSP-powered context about your project as you work.\",\"interface\":\"Terminal user interface\",\"website\":\"https://charm.land/crush\",\"capabilities\":[\"Switches between Anthropic, OpenAI, Gemini, Bedrock, and more, even mid-session with context preserved\",\"Keeps separate sessions and contexts per project, and pulls in extra context through Language Server Protocol\",\"Extends itself with MCP servers and Agent Skills\"],\"skillOnly\":false},{\"slug\":\"fx\",\"pageId\":\"fx\",\"name\":\"fx\",\"hostId\":\"fx\",\"strings\":[\"fx\"],\"mcp\":{\"count\":39306,\"host\":\"fx\"},\"skill\":{\"count\":15482,\"host\":\"fx\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Install fx as one tiny native binary and start an interactive session or run a single request with fx ask, with no background service required. Written in Zig, this open-source coding agent harness keeps things minimal and fast, from its system prompt design down to its 6.74 MiB binary, and its output is closer to a Unix shell than an IDE in the terminal. Embed the core with libfx, add your own tools, and connect skills or MCP servers.\",\"interface\":\"Terminal CLI, embeddable as a library (libfx)\",\"website\":\"https://fx.sh\",\"capabilities\":[\"Install one 6.74 MiB native binary for your terminal, CI, or agent sandbox\",\"Embed the core with libfx, add your own tools, and connect skills or MCP servers\",\"Stay model and provider agnostic: local models, gateways, direct API access, or subscriptions\"],\"skillOnly\":false},{\"slug\":\"iflow-cli\",\"pageId\":\"iflow-cli\",\"name\":\"iFlow CLI\",\"hostId\":\"iflow-cli\",\"strings\":[\"iFlow CLI\"],\"mcp\":{\"count\":13746,\"host\":\"iFlow CLI\"},\"skill\":{\"count\":15482,\"host\":\"iFlow CLI\"},\"plugin\":null,\"total\":29228,\"installable\":29228,\"topCategories\":[\"Agent Skills\",\"Developer Tools\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"profileType\":\"MCP servers + skills\",\"summary\":\"iFlow CLI was an AI assistant that ran directly in your terminal, analyzing code repositories, executing coding tasks, and automating everything from simple file operations to complex workflows. It offered free AI models, one-click SubAgent and MCP installs from the iFlow Open Market, and conversation history saving and rollback.\",\"interface\":\"Terminal CLI, with VS Code and JetBrains plugins\",\"website\":\"https://platform.iflow.cn/\",\"capabilities\":[\"Analyze code repositories and execute coding tasks directly in the terminal\",\"Install SubAgents and MCP in one click from the iFlow Open Market\",\"Save and roll back conversation history with iflow --resume and /chat\"],\"skillOnly\":false},{\"slug\":\"jazz\",\"pageId\":\"jazz\",\"name\":\"Jazz\",\"hostId\":\"jazz\",\"strings\":[\"Jazz\"],\"mcp\":{\"count\":38562,\"host\":\"Jazz\"},\"skill\":{\"count\":15482,\"host\":\"Jazz\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Jazz is an open-source AI assistant that reads and edits files, runs commands, researches the web, and creates documents and visuals. You choose its model and permissions, then use the same agent from your terminal, scripts, CI, schedules, or chat apps.\",\"interface\":\"Terminal CLI (also scripts, CI, schedules and chat apps)\",\"website\":\"https://jazz-cli.vercel.app\",\"capabilities\":[\"Reads and edits files, runs commands, researches the web\",\"Runs from your terminal, scripts, CI, schedules or chat apps\",\"Set budgets and gate actions behind approvals\"],\"skillOnly\":false},{\"slug\":\"junie\",\"pageId\":\"junie\",\"name\":\"Junie\",\"hostId\":\"junie\",\"strings\":[\"Junie\"],\"mcp\":{\"count\":38562,\"host\":\"Junie\"},\"skill\":{\"count\":15482,\"host\":\"Junie\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Junie is an AI coding agent from JetBrains. Junie CLI runs in your terminal and Junie Local runs inside JetBrains IDEs, and it keeps you in control — you review, guide, and approve changes as it works.\",\"interface\":\"Terminal CLI (also runs inside JetBrains IDEs)\",\"website\":\"https://junie.jetbrains.com\",\"capabilities\":[\"Built on the IntelliJ IDEA engine\",\"Bring your own key: supports 10+ models\",\"Review, guide and approve changes as it works\"],\"skillOnly\":false},{\"slug\":\"kilo\",\"pageId\":\"kilo\",\"name\":\"Kilo Code\",\"hostId\":\"kilo\",\"strings\":[\"Kilo Code\"],\"mcp\":{\"count\":38562,\"host\":\"Kilo Code\"},\"skill\":{\"count\":15482,\"host\":\"Kilo Code\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Kilo Code is an open-source AI coding assistant that works wherever you do — in your IDE, terminal, browser, or on the go. Generate code, automate reviews, debug issues, and ship faster with AI that understands your codebase.\",\"interface\":\"Terminal CLI (also IDE extensions, web, mobile and Slack)\",\"website\":\"https://kilo.ai\",\"capabilities\":[\"Specialized agents for Code, Plan, Debug and Ask — or create your own\",\"Runs in VS Code, JetBrains and the Kilo CLI from your terminal\",\"Sessions sync across IDE, browser, mobile and Slack\"],\"skillOnly\":false},{\"slug\":\"kimchi\",\"pageId\":\"kimchi\",\"name\":\"Kimchi Coding\",\"hostId\":\"kimchi\",\"strings\":[\"Kimchi\",\"Kimchi Coding\"],\"mcp\":{\"count\":39306,\"host\":\"Kimchi\"},\"skill\":{\"count\":15482,\"host\":\"Kimchi\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Kimchi Coding is an autonomous AI coding agent: describe a task in plain English and the harness reads your codebase, plans the work, writes code, runs commands and verifies the results, all in a terminal session. An orchestrator classifies each task and hands subtasks to the models best suited to them.\",\"interface\":\"Terminal CLI (coding harness in a terminal session)\",\"website\":\"https://kimchi.dev\",\"capabilities\":[\"Multi-model orchestration routes planning, building and reviewing to specialist models\",\"Ferment runs multi-step projects across sessions and picks up where it left off\",\"Built-in LSP and DAP support for type-aware edits and real debugging\"],\"skillOnly\":false},{\"slug\":\"kiro-cli\",\"pageId\":\"kiro-cli\",\"name\":\"Kiro CLI\",\"hostId\":\"kiro-cli\",\"strings\":[\"Kiro CLI\"],\"mcp\":{\"count\":38562,\"host\":\"Kiro CLI\"},\"skill\":{\"count\":15482,\"host\":\"Kiro CLI\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Kiro CLI brings AI-assisted development to your terminal. Build, test, and deploy applications using natural language commands and automated workflows.\",\"interface\":\"Terminal CLI (interactive chat, headless mode)\",\"website\":\"https://kiro.dev\",\"capabilities\":[\"Interactive chat with a terminal UI — syntax highlighting, panels and themes\",\"Headless mode runs prompts non-interactively in CI/CD pipelines\",\"Voice mode dictates prompts hands-free with local Whisper speech-to-text\"],\"skillOnly\":false},{\"slug\":\"kode\",\"pageId\":\"kode\",\"name\":\"Kode\",\"hostId\":\"kode\",\"strings\":[\"Kode\"],\"mcp\":{\"count\":39306,\"host\":\"Kode\"},\"skill\":{\"count\":15482,\"host\":\"Kode\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Run Kode in your terminal and let it understand your codebase, edit files, run commands, and handle whole workflows for you. It works with 20+ AI models and providers, and it picks up your project's AGENTS.md instructions automatically.\",\"interface\":\"Terminal AI assistant, run interactively or in one-shot mode\",\"website\":\"https://github.com/shareAI-lab/Kode-cli\",\"capabilities\":[\"Edit files and run shell commands as it works\",\"Switch and combine multiple AI models in one session\",\"Read AGENTS.md project instructions automatically\"],\"skillOnly\":false},{\"slug\":\"mux\",\"pageId\":\"mux\",\"name\":\"Xum\",\"hostId\":\"mux\",\"strings\":[\"Mux (Xum)\",\"Mux\",\"Xum\"],\"mcp\":{\"count\":13746,\"host\":\"Mux (Xum)\"},\"skill\":{\"count\":15482,\"host\":\"Mux\"},\"plugin\":null,\"total\":29228,\"installable\":29228,\"topCategories\":[\"Agent Skills\",\"Developer Tools\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"profileType\":\"MCP servers + skills\",\"summary\":\"Run several coding agents at once in Xum, each in its own isolated workspace, straight from your browser or desktop. Xum is open source and LLM provider-agnostic, so you can point it at any model provider. Install it on macOS, Linux or Windows and manage the whole suite of agents from one place.\",\"interface\":\"Desktop and browser app that runs agents in isolated workspaces\",\"website\":\"https://xum.coder.com\",\"capabilities\":[\"Run parallel coding agents, each in an isolated workspace\",\"Work with any LLM provider\",\"Review rich markdown output like mermaid diagrams and LaTeX\"],\"skillOnly\":false},{\"slug\":\"neovate\",\"pageId\":\"neovate\",\"name\":\"Neovate\",\"hostId\":\"neovate\",\"strings\":[\"Neovate\"],\"mcp\":{\"count\":39306,\"host\":\"Neovate\"},\"skill\":{\"count\":15482,\"host\":\"Neovate\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Use Neovate to generate code, fix bugs, review code, and add tests from the command line. Install it with npm, sign in to a provider or set your own API key, choose a model, then describe what you want and approve the changes it proposes.\",\"interface\":\"CLI you run interactively or headless\",\"website\":\"https://neovateai.dev\",\"capabilities\":[\"Generate code, fix bugs, review code and add tests\",\"Run interactively or headless\",\"Use any provider's API key, then switch models with /model\"],\"skillOnly\":false},{\"slug\":\"ona\",\"pageId\":\"ona\",\"name\":\"Ona\",\"hostId\":\"ona\",\"strings\":[\"Ona\"],\"mcp\":{\"count\":38562,\"host\":\"Ona\"},\"skill\":{\"count\":15482,\"host\":\"Ona\"},\"plugin\":null,\"total\":54044,\"installable\":54044,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Hand work to background agents running in the cloud and get pull requests back, from any device. Ona triggers agent fleets with repeatable workflows on PRs, schedules or webhooks, and keeps every execution governed with audit trails, scoped credentials and kernel-level policy enforcement.\",\"interface\":\"Cloud platform that runs background agents for you\",\"website\":\"https://ona.com\",\"capabilities\":[\"Run background agents that turn tasks into pull requests\",\"Trigger agent fleets on PRs, schedules, or webhooks\",\"Give each agent a full cloud environment with your tools and permissions\"],\"skillOnly\":false},{\"slug\":\"pochi\",\"pageId\":\"pochi\",\"name\":\"Pochi\",\"hostId\":\"pochi\",\"strings\":[\"Pochi\"],\"mcp\":{\"count\":39306,\"host\":\"Pochi\"},\"skill\":{\"count\":15482,\"host\":\"Pochi\"},\"plugin\":null,\"total\":54788,\"installable\":54788,\"topCategories\":[\"Developer Tools\",\"Agent Skills\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"remoteMcp\":true,\"profileType\":\"MCP servers + skills\",\"summary\":\"Chat with Pochi inside VS Code to generate and ship applications. Pochi is an open-source AI coding agent built as a VS Code extension: bring your own LLM provider by configuring API keys, or sign in for Pochi's managed models, shared task histories and team management.\",\"interface\":\"VS Code extension\",\"website\":\"https://getpochi.com\",\"capabilities\":[\"Install from the VS Code Marketplace or OpenVSX\",\"Use any LLM provider by configuring API keys\",\"Share task histories and manage your team with an account\"],\"skillOnly\":false},{\"slug\":\"zcode\",\"pageId\":\"zcode\",\"name\":\"ZCode\",\"hostId\":\"zcode\",\"strings\":[\"ZCode\"],\"mcp\":{\"count\":13746,\"host\":\"ZCode\"},\"skill\":{\"count\":15482,\"host\":\"ZCode\"},\"plugin\":null,\"total\":29228,\"installable\":29228,\"topCategories\":[\"Agent Skills\",\"Developer Tools\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"profileType\":\"MCP servers + skills\",\"summary\":\"ZCode is an agentic development environment built around GLM-5.3. Give it a task in plain language and the ZCode Agent plans, codes, tests and reviews the work in one long-running task, while you follow along and add instructions from the desktop, your phone, or a chat bot.\",\"interface\":\"Desktop app (also mobile Remote and Bot Channel)\",\"website\":\"https://zcode.z.ai\",\"capabilities\":[\"Keeps files, terminal output, browser context and Git state inside one task\",\"Handles coding, debugging, testing, project preview and change review from natural-language instructions\",\"Sensitive commands and file changes go through confirmation before they run\"],\"skillOnly\":false},{\"slug\":\"codestudio\",\"pageId\":\"codestudio\",\"name\":\"Code Studio\",\"hostId\":\"codestudio\",\"strings\":[\"Code Studio\"],\"mcp\":{\"count\":13746,\"host\":\"Code Studio\"},\"skill\":{\"count\":15482,\"host\":\"Code Studio\"},\"plugin\":null,\"total\":29228,\"installable\":29228,\"topCategories\":[\"Agent Skills\",\"Developer Tools\",\"TypeScript Skills\"],\"configFormat\":\"json\",\"profileType\":\"MCP servers + skills\",\"summary\":\"Code Studio is Syncfusion's AI-powered IDE for enterprise software teams. It brings design, planning and development work into one workspace for teams building complex enterprise systems.\",\"interface\":\"AI-powered IDE\",\"website\":\"https://www.syncfusion.com/code-studio\",\"capabilities\":[\"Design and plan enterprise software projects\",\"Build and ship complex enterprise systems\",\"Bring AI assistance into the development workspace\"],\"skillOnly\":false},{\"slug\":\"adal\",\"pageId\":\"adal\",\"name\":\"AdaL\",\"strings\":[\"AdaL\"],\"mcp\":null,\"skill\":{\"count\":15482,\"host\":\"AdaL\"},\"plugin\":null,\"total\":15482,\"installable\":15482,\"topCategories\":[\"Agent Skills\",\"TypeScript Skills\",\"Official Skills by\"],\"profileType\":\"Coding agent\",\"summary\":\"AdaL is Sylph’s AI agent for coding and computer tasks, available as a terminal tool and desktop app.\",\"interface\":\"Terminal and desktop app\",\"website\":\"https://docs.sylph.ai/\",\"capabilities\":[\"Works with code and local computer tasks\",\"Can be extended with skills and plugins\",\"Offers terminal and desktop interfaces\"],\"skillOnly\":true},{\"slug\":\"autohand-code\",\"pageId\":\"autohand-code\",\"name\":\"Autohand Code CLI\",\"strings\":[\"Autohand Code CLI\"],\"mcp\":null,\"skill\":{\"count\":15482,\"host\":\"Autohand Code CLI\"},\"plugin\":null,\"total\":15482,\"installable\":15482,\"topCategories\":[\"Agent Skills\",\"TypeScript Skills\",\"Official Skills by\"],\"profileType\":\"Coding agent\",\"summary\":\"Autohand Code is a terminal coding agent that explores a project, plans changes, edits files, and runs development tools.\",\"interface\":\"Terminal CLI\",\"website\":\"https://github.com/autohandai/code-cli\",\"capabilities\":[\"Reads and changes project files\",\"Plans and executes coding tasks\",\"Runs development tools from the terminal\"],\"skillOnly\":true},{\"slug\":\"codemaker\",\"pageId\":\"codemaker\",\"name\":\"Codemaker\",\"strings\":[\"Codemaker\"],\"mcp\":null,\"skill\":{\"count\":15482,\"host\":\"Codemaker\"},\"plugin\":null,\"total\":15482,\"installable\":15482,\"topCategories\":[\"Agent Skills\",\"TypeScript Skills\",\"Official Skills by\"],\"profileType\":\"VS Code assistant\",\"summary\":\"CodeMaker AI is a VS Code assistant for generating and improving code, with account access managed through the CodeMaker portal.\",\"interface\":\"VS Code extension\",\"website\":\"https://portal.codemaker.ai/\",\"capabilities\":[\"Adds AI coding assistance in VS Code\",\"Connects to a CodeMaker account\",\"Uses the vendor portal to manage access\"],\"skillOnly\":true},{\"slug\":\"continue\",\"pageId\":\"continue\",\"name\":\"Continue\",\"strings\":[\"Continue\"],\"mcp\":null,\"skill\":{\"count\":15482,\"host\":\"Continue\"},\"plugin\":null,\"total\":15482,\"installable\":15482,\"topCategories\":[\"Agent Skills\",\"TypeScript Skills\",\"Official Skills by\"],\"profileType\":\"Coding agent\",\"summary\":\"Continue CLI is a terminal coding agent for working through software tasks in a project; it shares the Continue platform with the IDE extensions.\",\"interface\":\"Terminal CLI and IDE extensions\",\"website\":\"https://www.continue.dev/\",\"capabilities\":[\"Reads and edits files in a project\",\"Runs commands as part of a task\",\"Available through the same platform as Continue IDE extensions\"],\"skillOnly\":true},{\"slug\":\"dexto\",\"pageId\":\"dexto\",\"name\":\"Dexto\",\"strings\":[\"Dexto\"],\"mcp\":null,\"skill\":{\"count\":15482,\"host\":\"Dexto\"},\"plugin\":null,\"total\":15482,\"installable\":15482,\"topCategories\":[\"Agent Skills\",\"TypeScript Skills\",\"Official Skills by\"],\"profileType\":\"Agent runtime\",\"summary\":\"Dexto is an open agent runtime for assembling model, tool, and skill access into task-focused assistants.\",\"interface\":\"Agent runtime and CLI\",\"website\":\"https://www.dexto.ai/\",\"capabilities\":[\"Connects language models to tools\",\"Organizes assistants around agent configurations\",\"Documents reusable skills for agents\"],\"skillOnly\":true},{\"slug\":\"eve\",\"pageId\":\"eve\",\"name\":\"Eve\",\"strings\":[\"Eve\"],\"mcp\":null,\"skill\":{\"count\":0,\"host\":\"Eve\"},\"plugin\":null,\"total\":0,\"installable\":0,\"topCategories\":[],\"profileType\":\"Agent framework\",\"summary\":\"Eve is an open-source framework from Vercel for building durable AI agents around a project and its files.\",\"interface\":\"Agent framework\",\"website\":\"https://eve.dev/\",\"capabilities\":[\"Builds agents around filesystem workspaces\",\"Supports durable, multi-step agent work\",\"Provides an open-source framework\"],\"skillOnly\":true},{\"slug\":\"goose\",\"pageId\":\"goose\",\"name\":\"Goose\",\"strings\":[\"Goose\"],\"mcp\":null,\"skill\":{\"count\":15482,\"host\":\"Goose\"},\"plugin\":null,\"total\":15482,\"installable\":15482,\"topCategories\":[\"Agent Skills\",\"TypeScript Skills\",\"Official Skills by\"],\"profileType\":\"Open-source agent\",\"summary\":\"Goose is Block’s open-source, general-purpose AI agent, available as a command-line tool and desktop app.\",\"interface\":\"CLI and desktop app\",\"website\":\"https://block.github.io/goose/\",\"capabilities\":[\"Runs as a local developer agent\",\"Connects to external tools and services\",\"Supports extensions and reusable workflows\"],\"skillOnly\":true},{\"slug\":\"hermes-agent\",\"pageId\":\"hermes-agent\",\"name\":\"Hermes Agent\",\"strings\":[\"Hermes Agent\"],\"mcp\":null,\"skill\":{\"count\":15482,\"host\":\"Hermes Agent\"},\"plugin\":null,\"total\":15482,\"installable\":15482,\"topCategories\":[\"Agent Skills\",\"TypeScript Skills\",\"Official Skills by\"],\"profileType\":\"Personal AI agent\",\"summary\":\"Hermes Agent is an open-source personal AI agent from Nous Research, with tools, memory, and reusable skills.\",\"interface\":\"Terminal and messaging interfaces\",\"website\":\"https://github.com/NousResearch/hermes-agent\",\"capabilities\":[\"Uses tools to carry out tasks\",\"Stores memory between conversations\",\"Can create and reuse skills\"],\"skillOnly\":true},{\"slug\":\"inference-sh\",\"pageId\":\"inference-sh\",\"name\":\"inference.sh\",\"strings\":[\"inference.sh\"],\"mcp\":null,\"skill\":{\"count\":15482,\"host\":\"inference.sh\"},\"plugin\":null,\"total\":15482,\"installable\":15482,\"topCategories\":[\"Agent Skills\",\"TypeScript Skills\",\"Official Skills by\"],\"profileType\":\"AI agent platform\",\"summary\":\"inference.sh is a platform and CLI for running AI models, agents, tools, and workflows.\",\"interface\":\"CLI and hosted platform\",\"website\":\"https://inference.sh/\",\"capabilities\":[\"Runs AI models and agents\",\"Connects tools into workflows\",\"Provides a command-line interface\"],\"skillOnly\":true},{\"slug\":\"lingma\",\"pageId\":\"lingma\",\"name\":\"Lingma\",\"strings\":[\"Lingma\"],\"mcp\":null,\"skill\":{\"count\":15482,\"host\":\"Lingma\"},\"plugin\":null,\"total\":15482,\"installable\":15482,\"topCategories\":[\"Agent Skills\",\"TypeScript Skills\",\"Official Skills by\"],\"profileType\