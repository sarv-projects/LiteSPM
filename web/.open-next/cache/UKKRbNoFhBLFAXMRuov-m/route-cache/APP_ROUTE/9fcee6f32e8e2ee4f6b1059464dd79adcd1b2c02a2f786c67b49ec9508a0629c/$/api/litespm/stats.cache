{"type":"route","meta":{"status":200,"headers":{"cache-control":"public, max-age=60, s-maxage=600, stale-while-revalidate=3600","content-type":"application/json","x-next-cache-tags":"_N_T_/layout,_N_T_/api/layout,_N_T_/api/litespm/layout,_N_T_/api/litespm/stats/layout,_N_T_/api/litespm/stats/route,_N_T_/api/litespm/stats"},"routeCache":{"key":"/route-cache/APP_ROUTE/9fcee6f32e8e2ee4f6b1059464dd79adcd1b2c02a2f786c67b49ec9508a0629c/$/api/litespm/stats","owner":{"kind":"APP_ROUTE","sourceRoute":"/api/litespm/stats/route"},"isFallback":false}},"body":"{\"telemetry\":{\"itemCount\":68933,\"createdAt\":\"2026-11-05T09:09:20Z\",\"releaseId\":\"rel-2026-11-05-03\",\"sequence\":154,\"manifestDigest\":\"sha256:3dc36b69d9a5da11088419fe7bbf4d32b621d54a3c37508f166f5b580496f328\",\"counts\":{\"all\":68933,\"mcp\":48040,\"skill\":20320,\"plugin\":573}},\"release\":{\"agentSkillsCount\":20320,\"createdAt\":\"2026-11-05T09:09:20Z\",\"datasetDigest\":\"sha256:7247fb2e034671d69d97b8779d9c8164938b5259173833ead5f97952e562c5c0\",\"hostCompatibility\":{\"mcp\":\"all-bridge-adapters\",\"plugin\":\"publisher-declared\",\"skill\":\"all-skill-targets\"},\"itemCount\":69376,\"manifestDigest\":\"sha256:3dc36b69d9a5da11088419fe7bbf4d32b621d54a3c37508f166f5b580496f328\",\"mcpServersCount\":48418,\"pluginsCount\":638,\"releaseId\":\"rel-2026-11-05-03\",\"sequence\":154,\"statsUpdatedAt\":\"2026-11-05T09:08:36Z\",\"totalCapabilities\":69376},\"cli\":{\"version\":\"0.6.0\",\"checkedAt\":\"2026-11-22\",\"verifiedBy\":\"npm dist-tags.latest on registry.npmjs.org (0.6.0, published 2026-10-22) cross-read against the git tag of the same version (`git show v0.6.0:cmd/litespm/main.go` → parseInstallFlags). The release that tag cut is the one the npm wrapper downloads its binary from.\",\"installFlags\":[\"--help\",\"-h\",\"--version\",\"-v\",\"--scope\",\"-s\",\"--workspace\",\"-w\",\"--host\",\"--agent\",\"-a\",\"--all-detected\",\"--env\",\"--force\",\"-f\",\"--frozen\",\"--dry-run\",\"--allow-partial\"],\"_readme\":[\"What a reader actually installs. `npx --yes litespm@latest` resolves to this\",\"version, so these are the only install flags the site may publish — the\",\"flags a reader's binary accepts is a property of npm, not of this working\",\"tree. That distinction is what let the site publish `--agent` and\",\"`--all-detected` while npm still served 0.4.1, which rejected both: the\",\"site printed a command whose answer was `unknown flag`.\",\"\",\"This file recorded 0.4.1 and its eight flags from 2026-10-22 until the\",\"0.6.0 release landed that evening, which is what let the site be honest\",\"in between. Keep it in step with npm: scripts/check-install-command.mjs\",\"asks the registry which version `latest` is (falling back to this file\",\"offline) and fails when they disagree, so a publish cannot leave this\",\"snapshot — and therefore the site — behind.\"]},\"uniqueTotal\":68933,\"rawTotal\":69376,\"counts\":{\"catalogRows\":69376,\"uniqueListings\":68933,\"distinctTools\":62591,\"installable\":55113,\"discoveryOnly\":13820,\"byKind\":{\"mcp\":48040,\"skill\":20320,\"plugin\":573},\"byInstallability\":{\"metadata_verified\":55361,\"discovery_only\":13572}},\"byKind\":{\"mcp\":48040,\"skill\":20320,\"plugin\":573},\"installable\":55113,\"withEndpoint\":25560,\"publishers\":30277,\"categories\":64,\"sources\":[[\"builtin:mcp-registry\",39705],[\"feed:skills-sh\",19206],[\"feed:punkpeye-awesome-mcp-servers\",4079],[\"feed:mcpmarket-com\",4000],[\"feed:voltagent-awesome-agent-skills\",1111],[\"git:claude-plugins-official\",299],[\"feed:mcpservers-org\",256],[\"git:cursor-plugins\",99],[\"git:knowledge-work-plugins\",74],[\"git:openai-plugins\",65],[\"git:xai-plugin-marketplace\",31],[\"git:anthropics-skills\",8]],\"transports\":[[\"streamable-http\",24816],[\"stdio\",13746],[\"sse\",744]],\"topCategories\":[[\"Developer Tools\",44974],[\"Agent Skills\",19209],[\"Finance & Crypto\",444],[\"TypeScript Skills\",444],[\"Productivity & Workflow\",341],[\"Knowledge & Memory\",327],[\"Search & Retrieval\",299],[\"Official Skills by\",285],[\"Community Skills\",271],[\"Security & Testing\",259],[\"Other Tools and Integrations\",186],[\"Databases\",182],[\"Communication\",163],[\"Cloud Infrastructure\",140],[\"Multimedia\",122],[\"Monitoring\",110],[\"Browser Automation\",103],[\"Plugins & Toolkits\",99],[\"Art & Culture\",88],[\"Gaming\",67],[\"Social Media\",62],[\"Location Services\",57],[\"Travel & Transportation\",56],[\"Data Platforms\",47]],\"goalCounts\":[[\"other\",20911],[\"business\",7207],[\"coding\",6347],[\"research\",6193],[\"infrastructure\",4311],[\"media\",4286],[\"security\",3932],[\"data\",3828],[\"automation\",3101],[\"productivity\",3069],[\"web\",2933],[\"communication\",2815]],\"hosts\":52,\"skillTargets\":81}"}