/95 px-3 py-1.5 text-[11px] shadow-xl backdrop-blur xl:flex\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-3.5 w-3.5 text-brand\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><span class=\"font-medium\">Backup saved</span><span class=\"font-mono text-muted-foreground\">~/.claude.json</span></div><div aria-hidden=\"true\" class=\"float-y pointer-events-none absolute -bottom-4 right-6 z-20 hidden items-center gap-2 rounded-xl border border-border/70 bg-card/95 px-3 py-1.5 text-[11px] shadow-xl backdrop-blur xl:flex\" style=\"animation-delay:-3s\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-undo2 lucide-undo-2 h-3.5 w-3.5 text-brand\" aria-hidden=\"true\"><path d=\"M9 14 4 9l5-5\"></path><path d=\"M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11\"></path></svg><span class=\"font-medium\">Managed removal or restore</span></div><div class=\"glow-frame shadow-[0_30px_90px_-30px_rgba(16,185,129,0.35)]\"><div class=\"relative overflow-hidden bg-[#0c1110] rounded-[calc(1.1rem-1px)] \" aria-label=\"LiteSPM interactive terminal session\"><div class=\"flex items-center justify-between gap-2 border-b border-white/[0.08] bg-white/[0.03] px-3 py-2.5 backdrop-blur-sm sm:px-4\"><div class=\"flex items-center gap-2\"><span class=\"flex items-center gap-1.5\" aria-hidden=\"true\"><span class=\"h-3 w-3 rounded-full bg-rose-500/80 transition-opacity hover:opacity-100\"></span><span class=\"h-3 w-3 rounded-full bg-amber-500/8