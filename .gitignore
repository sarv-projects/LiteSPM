# Binaries and executables
/litespm
/litespm.exe
dist/
*.exe
*.dll
*.so
*.dylib

# Test artifacts and coverage
*.test
*.out
cover.html

# Local database and caches
*.db
*.db-wal
*.db-shm
daemon.lock
# Fetch snapshot layer: recorded upstream bytes for reproducible catalog builds
# (scripts/snapshot_store.py). A cache, not a published artifact.
source-snapshots/

# CLI acceptance / scratch output. Throwaway run directories, never repo content.
tmp-cli-sandbox-*/
tmp-catalog-*/

# Agent-harness session state (goals, locks, per-session scratch).
.opencode/

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Web frontend artifacts
web/node_modules/
web/.next/
web/out/
# Built by `litespm catalog build --out web/public` at release/deploy time;
# the committed artifact is the pointer web/public/v1/current.json only.
web/public/v1/releases/
pages-dist/
*.tsbuildinfo
__pycache__/

# Cloudflare CLI local state (auth cache, temp files)
.wrangler/

# Local browser console logs (test scratch)
.playwright-mcp/

# Deepwork progress is session-local; see .ignore for agent visibility.
.slim/deepwork/
tmp-oh-my-pi/
tmp-agent-sandbox-*/

# Per-agent research scratch (raw fetched pages, gathered logo candidates and
# the quoted-source files behind web/lib/hostNotes.ts). The reviews that matter
# are committed: the prose and its `source` URLs live in `lib/hostNotes.ts`, and
# the marks that ship live in `web/public/brands/`.
.hostnotes-work/

# Engram AI agent memory
.engram/
