{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litespm.dev/schemas/v1/listing.schema.json",
  "title": "Listing",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "name",
    "summary",
    "categories",
    "source",
    "versions",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(plugin|mcp|skill|connector|agent|rule|hook|tool|lsp):[a-z0-9_:-]+:[A-Za-z0-9_.~%+-]+$"
    },
    "kind": {
      "type": "string",
      "enum": ["plugin", "mcp", "skill", "agent", "rule", "hook", "tool", "lsp"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "description": { "type": "string" },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "publisherClaim": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "contact": { "type": "string" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["sourceId", "upstreamId"],
      "properties": {
        "sourceId": { "type": "string" },
        "upstreamId": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version"],
        "properties": {
          "version": { "type": "string" },
          "immutableRef": { "type": "string" },
          "publishedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "componentsSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name"],
        "properties": {
          "kind": { "type": "string" },
          "name": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "requirementsSummary": {
      "type": "array",
      "items": { "type": "string" }
    },
    "compatibilitySummary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hostId", "status"],
        "properties": {
          "hostId": { "type": "string" },
          "hostVersion": { "type": "string" },
          "status": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "verificationSummary": {
      "type": "object",
      "required": ["level", "auditedAt"],
      "properties": {
        "level": { "type": "string" },
        "auditedAt": { "type": "string", "format": "date-time" },
        "auditor": { "type": "string" },
        "scoreStars": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["sourceSnapshotId", "ingestedAt"],
      "properties": {
        "sourceSnapshotId": { "type": "string" },
        "ingestedAt": { "type": "string", "format": "date-time" },
        "catalogReleaseId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["active", "stale", "deprecated", "withdrawn", "unavailable"]
    },
    "installability": {
      "type": "string",
      "enum": ["discovery_only", "metadata_verified", "runtime_verified", "litespm_tested"],
      "description": "How far installability has been proven. Absent is treated as discovery_only."
    },
    "rawMetadataRef": { "type": "string" }
  },
  "additionalProperties": false
}
