{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litespm.dev/schemas/v1/install-plan.schema.json",
  "title": "InstallPlan",
  "type": "object",
  "required": [
    "schemaVersion",
    "planId",
    "planHash",
    "createdAt",
    "expiresAt",
    "catalogReleaseId",
    "request",
    "resolved",
    "effects",
    "preconditions",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "planId": {
      "type": "string",
      "pattern": "^plan_[0-9A-Za-z]{26}$"
    },
    "planHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "catalogReleaseId": {
      "type": "string"
    },
    "sourceSnapshots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "request": {
      "type": "object",
      "required": ["listingId", "targetScope"],
      "properties": {
        "listingId": { "type": "string" },
        "requestedVersion": { "type": "string" },
        "selectedComponents": {
          "type": "array",
          "items": { "type": "string" }
        },
        "targetScope": {
          "type": "string",
          "enum": ["user", "project"]
        },
        "targetHost": { "type": "string" },
        "workspaceId": { "type": "string" },
        "projectRoot": { "type": "string" }
      },
      "additionalProperties": false
    },
    "resolved": {
      "type": "object",
      "required": ["version", "artifacts"],
      "properties": {
        "version": { "type": "string" },
        "immutableRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifactId", "type", "locator"],
            "properties": {
              "artifactId": { "type": "string" },
              "type": { "type": "string" },
              "locator": { "type": "string" },
              "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "size": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "runtimeRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "name"],
            "properties": {
              "type": { "type": "string" },
              "name": { "type": "string" },
              "version": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preconditions": {
      "type": "object",
      "properties": {
        "filesystemPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "portsAvailable": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "runtimesFound": {
          "type": "array",
          "items": { "type": "string" }
        },
        "diskSpaceBytes": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["channel", "decision"],
      "properties": {
        "approvalId": { "type": "string" },
        "channel": { "type": "string" },
        "decision": { "type": "string" },
        "decidedAt": { "type": "string", "format": "date-time" },
        "approvedBy": { "type": "string" }
      },
      "additionalProperties": false
    },
    "hostChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hostId", "configPath", "action", "entryKey"],
        "properties": {
          "hostId": { "type": "string" },
          "configPath": { "type": "string" },
          "action": { "type": "string" },
          "entryKey": { "type": "string" },
          "valueJson": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "providerLaunches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["providerId", "transport"],
        "properties": {
          "providerId": { "type": "string" },
          "transport": { "type": "string" },
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "env": { "type": "object", "additionalProperties": { "type": "string" } },
          "endpoint": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "requestedAccess": {
      "type": "object",
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } },
        "paths": { "type": "array", "items": { "type": "string" } },
        "hosts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
