{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litespm.dev/schemas/v1/version.schema.json",
  "title": "VersionRecord",
  "type": "object",
  "required": [
    "listingId",
    "version",
    "sourceSnapshotId",
    "artifacts",
    "components",
    "fetchedAt"
  ],
  "properties": {
    "listingId": {
      "type": "string",
      "pattern": "^(plugin|mcp|skill|connector|agent|rule|hook|tool|lsp):[a-z0-9_:-]+:[A-Za-z0-9_.~%+-]+$"
    },
    "version": {
      "type": "string"
    },
    "immutableRef": {
      "type": "string"
    },
    "sourceSnapshotId": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifactId", "type", "locator"],
        "properties": {
          "artifactId": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["git-tree", "archive", "npm", "pypi", "cargo", "oci", "nuget", "mcpb", "local-dir", "remote-only", "other"]
          },
          "locator": { "type": "string" },
          "immutableRef": { "type": "string" },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "mediaType": { "type": "string" },
          "subpath": { "type": "string" },
          "runtimeDescriptor": { "type": "string" },
          "fetchPolicy": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "declaredEffects", "supportedByLiteSPM"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["skill", "mcp-provider", "hook", "command", "agent-definition", "agent", "rule", "tool", "asset", "host-app", "lsp", "other"]
          },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "sourceArtifactId": { "type": "string" },
          "hostExtensions": { "type": "object" },
          "runtime": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string" },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "endpoint": { "type": "string" },
              "workingDir": { "type": "string" }
            },
            "additionalProperties": false
          },
          "declaredEffects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "provenance", "confidence"],
              "properties": {
                "type": { "type": "string" },
                "target": { "type": "string" },
                "provenance": { "type": "string" },
                "confidence": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "supportedByLiteSPM": {
            "type": "string",
            "enum": ["yes", "partial", "no", "unknown"]
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["listingId", "constraint"],
        "properties": {
          "listingId": { "type": "string" },
          "constraint": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": { "type": "string" },
          "name": { "type": "string" },
          "version": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "permissionsDeclared": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "target": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "compatibilityClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hostId", "status"],
        "properties": {
          "hostId": { "type": "string" },
          "hostVersion": { "type": "string" },
          "status": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "testEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hostId", "passed", "executedAt"],
        "properties": {
          "hostId": { "type": "string" },
          "passed": { "type": "boolean" },
          "executedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["keyId", "signature", "algorithm"],
        "properties": {
          "keyId": { "type": "string" },
          "signature": { "type": "string" },
          "algorithm": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "publishedAt": { "type": "string", "format": "date-time" },
    "fetchedAt": { "type": "string", "format": "date-time" },
    "rawMetadataRef": { "type": "string" }
  },
  "additionalProperties": false
}
